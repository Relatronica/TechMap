---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import MapView from '../components/MapView.astro';
import i18n from '../i18n/it.json';
import {
  ICON_PATHS,
  FILTER_GROUPS,
  CONNECTION_TYPES,
  CONTEXT_OVERLAYS,
  SUBTYPE_COLORS,
  ICON_OPACITY_EXPR,
  SITE_ICON_OPACITY_EXPR,
  SITE_STATUSES,
  STATUS_COLORS,
  STATUS_GET_EXPR,
  ICON_STATUS_STYLES,
  ICON_CANVAS_SIZE,
  ICON_PIXEL_RATIO,
  STATUS_BADGE_PIXEL_RATIO,
  ICON_SIZE_BY_ZOOM,
  ICON_SIZE_HIGHLIGHT_BY_ZOOM,
  ICON_SIZE_RELATED_BY_ZOOM,
  ICON_SIZE_DIMMED_BY_ZOOM,
  ICON_SIZE,
  ICON_SIZE_HIGHLIGHT,
  ICON_SIZE_RELATED,
  ICON_SIZE_DIMMED
} from '../lib/mapIcons';

const STATUS_SHORT_LABELS = {
  operational: i18n.controls.status_short.operational,
  under_construction: i18n.controls.status_short.under_construction,
  planned: i18n.controls.status_short.planned,
  decommissioned: i18n.controls.status_short.decommissioned,
  unknown: i18n.controls.status_short.unknown
};
---

<Layout
  title={`${i18n.app.title} — Mappa`}
  description={i18n.home.hero_sub}
  withMap={true}
  bodyClass="is-map"
>
  <MapView />

  <script>
    import { buildImpactModel } from '../lib/impactEstimates';
    (window as Window & { SubstratoImpact?: { buildImpactModel: typeof buildImpactModel } }).SubstratoImpact = {
      buildImpactModel
    };
  </script>

  <!-- Client-side MapLibre Script -->
  <script is:inline define:vars={{ ICON_PATHS, FILTER_GROUPS, CONNECTION_TYPES, CONTEXT_OVERLAYS, SUBTYPE_COLORS, ICON_OPACITY_EXPR, SITE_ICON_OPACITY_EXPR, SITE_STATUSES, STATUS_COLORS, STATUS_GET_EXPR, ICON_STATUS_STYLES, ICON_CANVAS_SIZE, ICON_PIXEL_RATIO, STATUS_BADGE_PIXEL_RATIO, ICON_SIZE_BY_ZOOM, ICON_SIZE_HIGHLIGHT_BY_ZOOM, ICON_SIZE_RELATED_BY_ZOOM, ICON_SIZE_DIMMED_BY_ZOOM, ICON_SIZE, ICON_SIZE_HIGHLIGHT, ICON_SIZE_RELATED, ICON_SIZE_DIMMED, STATUS_SHORT_LABELS }}>
    // MapLibre GL JS loaded from CDN as global `maplibregl`
    var MaplibreMap = maplibregl.Map;
    var NavigationControl = maplibregl.NavigationControl;

    // i18n strings loaded inline for client-side use
    const i18n = {
      app: {
        title: "Substrato",
        subtitle: "L'Infrastruttura Invisibile"
      },
      layers: {
        data_centers: "Data Center",
        raw_materials: "Materie Prime e Produzione",
        energy_plants: "Impianti Energetici",
        connections: "Connessioni"
      },
      subtypes: {
        colocation: "Colocation",
        hyperscale: "Hyperscale",
        enterprise: "Enterprise",
        semiconductor_fab: "Fabbrica di semiconduttori",
        component_manufacturing: "Produzione componenti",
        chip_design: "Design chip (fabless)",
        server_assembly: "Assemblaggio server (ODM)",
        battery_materials: "Materiali per batterie",
        lithium_mine: "Miniera di litio",
        cobalt_mine: "Miniera di cobalto",
        rare_earth_mine: "Miniera di terre rare",
        gas: "Gas naturale (ciclo combinato)",
        solar: "Solare fotovoltaico",
        wind: "Eolico",
        hydro: "Idroelettrico",
        nuclear: "Nucleare"
      },
      relationships: {
        powers: "Alimenta",
        supplies: "Fornisce materiali",
        manufactures_for: "Produce componenti per"
      },
      popup: {
        operator: "Operatore",
        type: "Tipo",
        capacity: "Capacità",
        city: "Città",
        country: "Paese",
        description: "Descrizione",
        connections: "Connessioni",
        connections_hint: "Segui un legame per spostarti al sito collegato.",
        open_connected: "Apri sulla mappa",
        linked_sites: "Siti del legame",
        powered_by: "Alimentato da",
        components_from: "Componenti da",
        supplies_from: "Forniture da",
        powers_to: "Alimenta",
        supplies_to: "Fornisce a",
        receives_from: "Riceve da",
        manufactures_to: "Produce per",
        relationship: "Relazione",
        close: "Chiudi",
        impact: "Impatto",
        capacity_mw: "Potenza (MW)",
        pue: "PUE",
        water_use: "Acqua (m³/anno)",
        land: "Suolo (ha)",
        co2: "CO₂ stimata (t/anno)",
        energy_mix: "Mix / note energia",
        impact_power: "Potenza",
        impact_electricity: "Elettricità",
        impact_co2: "CO₂",
        impact_water: "Acqua",
        impact_land: "Suolo",
        impact_pue: "PUE",
        impact_badge_declared: "Dichiarato",
        impact_badge_estimated: "Stima",
        impact_equiv_households: "≈ {n} abitazioni/anno",
        impact_disclaimer: "Le stime usano fattori medi di rete e di settore (carico, intensità carbonica, acqua di raffreddamento). Non sono bilanci ufficiali del sito.",
        impact_empty: "Dati di impatto non ancora compilati.",
        employment: "Lavoro",
        jobs_direct: "Occupati diretti",
        jobs_indirect: "Indiretti (stima)",
        jobs_contractors: "Appalti / temporanei (stima)",
        labor_risks: "Rischi lavoro / territorio",
        labor_contrast: "Confronta questo organico con miniere, fab e ODM lungo la stessa filiera: il cloud sposta il lavoro, non lo cancella.",
        labor_conditions: "Condizioni",
        community: "Territorio e comunità",
        sources: "Fonti",
        confidence: "Affidabilità dato",
        certainty: "Certezza del legame",
        evidence: "Evidenza",
        updated_at: "Aggiornato",
        status: "Stato"
      },
      confidence: {
        high: "Alta",
        medium: "Media",
        low: "Bassa",
        estimated: "Stima"
      },
      certainty: {
        confirmed: "Confermato",
        likely: "Probabile",
        inferred: "Inferito",
        disputed: "Conteso"
      },
      labor_tags: {
        unionized: "Sindacalizzato",
        shift_work: "Lavoro a turni",
        artisanal_mining: "Estrazione artigianale",
        artisanal_mining_nearby: "Artigianale nelle vicinanze",
        conflict_zone: "Zona di conflitto",
        migrant_labor: "Lavoro migrante",
        high_skill: "Alta specializzazione",
        construction_phase: "Fase di cantiere",
        precarious_contracts: "Contratti precari",
        chemical_exposure: "Esposizione chimica"
      },
      status: {
        planned: "Pianificato",
        under_construction: "In costruzione",
        operational: "Operativo",
        decommissioned: "Disattivato",
        unknown: "Sconosciuto"
      },
      countries: {
        IT: "Italia", DE: "Germania", ES: "Spagna", NL: "Paesi Bassi", BE: "Belgio",
        AT: "Austria", PL: "Polonia", FI: "Finlandia", SE: "Svezia", IE: "Irlanda",
        FR: "Francia", PT: "Portogallo", GR: "Grecia", CZ: "Rep. Ceca", RO: "Romania",
        HU: "Ungheria", DK: "Danimarca", LU: "Lussemburgo", NO: "Norvegia", CH: "Svizzera",
        RS: "Serbia", TW: "Taiwan", AU: "Australia", CL: "Cile", CD: "Rep. Dem. del Congo",
        GL: "Groenlandia", CN: "Cina", US: "Stati Uniti", XX: "Non specificato"
      }

    };

    // Store loaded GeoJSON data for cross-referencing connections
    let connectionsData = null;
    let dataCentersData = null;
    let rawMaterialsData = null;
    let energyPlantsData = null;

    const COLORS = {
      dc: '#5A9BB8',
      rm: '#B87A4A',
      ep: '#5B8FA8',
      conn: '#8a9199'
    };

    // Initialize map
    const map = new MaplibreMap({
      container: 'map',
      style: 'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json',
      center: [11.0, 44.5],
      zoom: 5,
      minZoom: 2,
      maxZoom: 18,
      attributionControl: { compact: true }
    });

    function expandAttribution() {
      const attrib = map.getContainer().querySelector('.maplibregl-ctrl-attrib');
      if (attrib) attrib.setAttribute('open', '');
    }
    map.on('load', expandAttribution);
    map.once('idle', expandAttribution);

    // Add navigation controls bottom-left
    map.addControl(new NavigationControl({ showCompass: false }), 'bottom-left');

    // —— Place search (Nominatim) ——
    (function initPlaceSearch() {
      const root = document.getElementById('map-search');
      const form = document.getElementById('map-search-form');
      const input = document.getElementById('map-search-input');
      const clearBtn = document.getElementById('map-search-clear');
      const resultsEl = document.getElementById('map-search-results');
      const statusEl = document.getElementById('map-search-status');
      if (!root || !form || !input || !clearBtn || !resultsEl || !statusEl) return;

      const msgSearching = root.dataset.msgSearching || 'Cerco…';
      const msgEmpty = root.dataset.msgEmpty || 'Nessun risultato';
      const msgError = root.dataset.msgError || 'Ricerca non disponibile';

      let debounceTimer = null;
      let abortCtrl = null;
      let activeIndex = -1;
      let currentResults = [];

      function setStatus(text) {
        if (!text) {
          statusEl.hidden = true;
          statusEl.textContent = '';
          return;
        }
        statusEl.hidden = false;
        statusEl.textContent = text;
      }

      function clearResults() {
        currentResults = [];
        activeIndex = -1;
        resultsEl.innerHTML = '';
        resultsEl.hidden = true;
      }

      function closeSearchUi() {
        clearResults();
        setStatus('');
      }

      function syncClearBtn() {
        clearBtn.hidden = input.value.trim().length === 0;
      }

      function labelForResult(item) {
        const addr = item.address || {};
        const name =
          addr.city ||
          addr.town ||
          addr.village ||
          addr.municipality ||
          addr.county ||
          addr.state ||
          addr.region ||
          addr.country ||
          item.name ||
          (item.display_name || '').split(',')[0];
        const parts = [
          addr.state || addr.region,
          addr.country
        ].filter(Boolean);
        const unique = parts.filter((p) => p && p !== name);
        return {
          name: name || item.display_name,
          meta: unique.join(' · ')
        };
      }

      function goToResult(item) {
        if (!item) return;
        const bb = item.boundingbox;
        if (bb && bb.length === 4) {
          const south = parseFloat(bb[0]);
          const north = parseFloat(bb[1]);
          const west = parseFloat(bb[2]);
          const east = parseFloat(bb[3]);
          if ([south, north, west, east].every(Number.isFinite)) {
            map.fitBounds(
              [
                [west, south],
                [east, north]
              ],
              { padding: { top: 56, bottom: 96, left: 56, right: 56 }, maxZoom: 12, duration: 1200 }
            );
        closeSearchUi();
        input.blur();
        document.body.classList.remove('search-open');
        const searchToggleBtn = document.getElementById('map-search-toggle');
        if (searchToggleBtn) searchToggleBtn.setAttribute('aria-expanded', 'false');
        return;
          }
        }
        const lon = parseFloat(item.lon);
        const lat = parseFloat(item.lat);
        if (Number.isFinite(lon) && Number.isFinite(lat)) {
          map.flyTo({ center: [lon, lat], zoom: 10, duration: 1200 });
        }
        closeSearchUi();
        input.blur();
        document.body.classList.remove('search-open');
        const searchToggleBtn = document.getElementById('map-search-toggle');
        if (searchToggleBtn) searchToggleBtn.setAttribute('aria-expanded', 'false');
      }

      function renderResults(items) {
        currentResults = items;
        activeIndex = items.length ? 0 : -1;
        resultsEl.innerHTML = '';
        if (!items.length) {
          resultsEl.hidden = true;
          return;
        }
        items.forEach((item, index) => {
          const { name, meta } = labelForResult(item);
          const li = document.createElement('li');
          li.setAttribute('role', 'option');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'map-search-option' + (index === 0 ? ' is-active' : '');
          btn.dataset.index = String(index);
          btn.innerHTML =
            `<span class="map-search-option-name"></span>` +
            (meta ? `<span class="map-search-option-meta"></span>` : '');
          btn.querySelector('.map-search-option-name').textContent = name;
          const metaEl = btn.querySelector('.map-search-option-meta');
          if (metaEl) metaEl.textContent = meta;
          btn.addEventListener('click', () => goToResult(item));
          li.appendChild(btn);
          resultsEl.appendChild(li);
        });
        resultsEl.hidden = false;
      }

      function setActiveOption(index) {
        const options = resultsEl.querySelectorAll('.map-search-option');
        if (!options.length) return;
        activeIndex = (index + options.length) % options.length;
        options.forEach((el, i) => el.classList.toggle('is-active', i === activeIndex));
        options[activeIndex].scrollIntoView({ block: 'nearest' });
      }

      async function runSearch(query) {
        if (abortCtrl) abortCtrl.abort();
        abortCtrl = new AbortController();
        setStatus(msgSearching);
        clearResults();
        try {
          const url = new URL('https://nominatim.openstreetmap.org/search');
          url.searchParams.set('q', query);
          url.searchParams.set('format', 'jsonv2');
          url.searchParams.set('addressdetails', '1');
          url.searchParams.set('limit', '6');
          url.searchParams.set('accept-language', 'it');
          // Preferenza Europa (viewbox) senza esclusione stretta
          url.searchParams.set('viewbox', '-12,72,45,34');
          url.searchParams.set('bounded', '0');

          const res = await fetch(url.toString(), {
            signal: abortCtrl.signal,
            headers: { Accept: 'application/json' }
          });
          if (!res.ok) throw new Error('nominatim ' + res.status);
          const data = await res.json();
          const items = Array.isArray(data) ? data : [];
          if (!items.length) {
            setStatus(msgEmpty);
            return;
          }
          setStatus('');
          renderResults(items);
        } catch (err) {
          if (err && err.name === 'AbortError') return;
          setStatus(msgError);
        }
      }

      function scheduleSearch() {
        const q = input.value.trim();
        syncClearBtn();
        if (debounceTimer) clearTimeout(debounceTimer);
        if (q.length < 2) {
          if (abortCtrl) abortCtrl.abort();
          closeSearchUi();
          return;
        }
        debounceTimer = setTimeout(() => runSearch(q), 380);
      }

      input.addEventListener('input', scheduleSearch);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActiveOption(activeIndex + 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActiveOption(activeIndex - 1);
        } else if (e.key === 'Escape') {
          closeSearchUi();
          input.blur();
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeIndex >= 0 && currentResults[activeIndex]) {
            goToResult(currentResults[activeIndex]);
          } else if (input.value.trim().length >= 2) {
            runSearch(input.value.trim());
          }
        }
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (activeIndex >= 0 && currentResults[activeIndex]) {
          goToResult(currentResults[activeIndex]);
        } else if (input.value.trim().length >= 2) {
          runSearch(input.value.trim());
        }
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        syncClearBtn();
        closeSearchUi();
        input.focus();
      });

      document.addEventListener('click', (e) => {
        if (!root.contains(e.target)) closeSearchUi();
      });
    })();

    // Tooltip element
    const tooltip = document.getElementById('map-tooltip');

    // Detail sidebar
    const detailSidebar = document.getElementById('detail-sidebar');
    const detailTitle = document.getElementById('detail-title');
    const detailType = document.getElementById('detail-type');
    const detailBody = document.getElementById('detail-body');
    const detailClose = document.getElementById('detail-close');

    detailClose.addEventListener('click', closeDetailSidebar);

    function closeDetailSidebar() {
      detailSidebar.classList.remove('open');
      detailSidebar.classList.remove('is-pulse');
      document.body.classList.remove('detail-open');
      resetHighlights();
    }

    function mixHex(a, b, t) {
      const parse = (hex) => {
        const h = String(hex).replace('#', '');
        const full = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
        const n = parseInt(full, 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      };
      const [ar, ag, ab] = parse(a);
      const [br, bg, bb] = parse(b);
      const clamp = (v) => Math.max(0, Math.min(255, Math.round(v)));
      return (
        '#' +
        [clamp(ar + (br - ar) * t), clamp(ag + (bg - ag) * t), clamp(ab + (bb - ab) * t)]
          .map((v) => v.toString(16).padStart(2, '0'))
          .join('')
      );
    }

    function clearIconShadow(ctx) {
      ctx.shadowColor = 'transparent';
      ctx.shadowBlur = 0;
      ctx.shadowOffsetX = 0;
      ctx.shadowOffsetY = 0;
    }

    function paintIconDropShadow(ctx, path, lineWidth, opts = {}) {
      const drop = opts.drop ?? 0.42;
      const dropY = opts.dropY ?? 1.15;

      ctx.shadowColor = `rgba(15, 18, 22, ${drop})`;
      ctx.shadowBlur = 3.8;
      ctx.shadowOffsetX = 0;
      ctx.shadowOffsetY = dropY;
      ctx.strokeStyle = 'rgba(15, 18, 22, 0.22)';
      ctx.lineWidth = lineWidth + 0.35;
      ctx.stroke(path);

      clearIconShadow(ctx);
    }

    function createMapIconImage(pathD, color, size = ICON_CANVAS_SIZE, style = 'solid') {
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');
      const scale = (size * 0.68) / 24;
      const path = new Path2D(pathD);

      ctx.save();
      ctx.translate(size / 2 - 12 * scale, size / 2 - 12 * scale);
      ctx.scale(scale, scale);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.miterLimit = 2;

      if (style === 'solid') {
        const lw = 2.75;
        paintIconDropShadow(ctx, path, lw, { drop: 0.48, dropY: 1.2 });
        ctx.fillStyle = color;
        ctx.strokeStyle = color;
        ctx.lineWidth = lw;
        ctx.fill(path);
        ctx.stroke(path);
      } else if (style === 'construction') {
        const warm = mixHex(color, STATUS_COLORS.under_construction, 0.78);
        const lw = 2.65;
        paintIconDropShadow(ctx, path, lw, { drop: 0.4, dropY: 1.1 });
        ctx.fillStyle = mixHex(warm, '#F2C078', 0.18);
        ctx.globalAlpha = 0.82;
        ctx.fill(path);
        ctx.globalAlpha = 1;
        ctx.strokeStyle = STATUS_COLORS.under_construction;
        ctx.lineWidth = lw;
        ctx.stroke(path);
      } else if (style === 'planned') {
        const ink = mixHex(color, STATUS_COLORS.planned, 0.35);
        const lw = 1.85;
        paintIconDropShadow(ctx, path, lw, { drop: 0.22, dropY: 0.7 });
        ctx.strokeStyle = ink;
        ctx.lineWidth = 1.65;
        ctx.globalAlpha = 0.38;
        ctx.stroke(path);
        ctx.globalAlpha = 1;
        ctx.lineWidth = 1.85;
        ctx.setLineDash([0.9, 1.15]);
        ctx.stroke(path);
        ctx.setLineDash([]);
      } else {
        const muted = mixHex(color, '#7a7e82', 0.72);
        const lw = 1.95;
        paintIconDropShadow(ctx, path, lw, { drop: 0.2, dropY: 0.65 });
        ctx.strokeStyle = muted;
        ctx.lineWidth = lw;
        ctx.globalAlpha = 0.88;
        ctx.stroke(path);
        ctx.globalAlpha = 1;
      }

      ctx.restore();

      return {
        width: size,
        height: size,
        data: ctx.getImageData(0, 0, size, size).data
      };
    }

    function iconImageId(subtype, style = 'solid') {
      return style === 'solid' ? 'icon-' + subtype : 'icon-' + subtype + '--' + style;
    }

    function buildIconMatch(subtypes, fallbackSubtype, style = 'solid') {
      const expr = ['match', ['get', 'subtype']];
      subtypes.forEach((s) => {
        expr.push(s, iconImageId(s, style));
      });
      expr.push(iconImageId(fallbackSubtype, style));
      return expr;
    }

    function buildStatusAwareIconMatch(subtypes, fallbackSubtype) {
      return [
        'match',
        STATUS_GET_EXPR,
        'under_construction',
        buildIconMatch(subtypes, fallbackSubtype, 'construction'),
        'planned',
        buildIconMatch(subtypes, fallbackSubtype, 'planned'),
        'decommissioned',
        buildIconMatch(subtypes, fallbackSubtype, 'retired'),
        buildIconMatch(subtypes, fallbackSubtype, 'solid')
      ];
    }

    function statusBadgeImageId(status, subtype) {
      return subtype ? 'status-badge-' + subtype + '--' + status : 'status-badge-' + status;
    }

    function roundRectPath(ctx, x, y, w, h, r) {
      const radii = typeof r === 'number' ? { tl: r, tr: r, br: r, bl: r } : r;
      ctx.beginPath();
      ctx.moveTo(x + radii.tl, y);
      ctx.lineTo(x + w - radii.tr, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + radii.tr);
      ctx.lineTo(x + w, y + h - radii.br);
      ctx.quadraticCurveTo(x + w, y + h, x + w - radii.br, y + h);
      ctx.lineTo(x + radii.bl, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - radii.bl);
      ctx.lineTo(x, y + radii.tl);
      ctx.quadraticCurveTo(x, y, x + radii.tl, y);
      ctx.closePath();
    }

    function drawStatusSwatch(ctx, status, accent, x, y, r) {
      ctx.save();
      if (status === 'operational') {
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = accent;
        ctx.fill();
      } else if (status === 'under_construction') {
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = accent;
        ctx.globalAlpha = 0.42;
        ctx.fill();
        ctx.globalAlpha = 1;
        ctx.strokeStyle = accent;
        ctx.lineWidth = 2.5;
        ctx.stroke();
      } else if (status === 'planned') {
        ctx.beginPath();
        ctx.arc(x, y, r - 0.5, 0, Math.PI * 2);
        ctx.strokeStyle = accent;
        ctx.lineWidth = 2;
        ctx.setLineDash([2.2, 2.2]);
        ctx.stroke();
        ctx.setLineDash([]);
      } else if (status === 'decommissioned') {
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = accent;
        ctx.globalAlpha = 0.4;
        ctx.fill();
        ctx.globalAlpha = 0.75;
        ctx.strokeStyle = accent;
        ctx.lineWidth = 2;
        ctx.stroke();
      } else {
        ctx.beginPath();
        ctx.arc(x, y, r - 0.5, 0, Math.PI * 2);
        ctx.strokeStyle = accent;
        ctx.lineWidth = 2;
        ctx.setLineDash([1.2, 2.4]);
        ctx.stroke();
        ctx.setLineDash([]);
      }
      ctx.restore();
    }

    /** Chip stato: allineato ai filter-chip (superficie scura, pallino semantico). */
    function createStatusBadgeImage(status, label, accent) {
      const font = '500 22px "IBM Plex Sans", "Helvetica Neue", Arial, sans-serif';
      const measure = document.createElement('canvas').getContext('2d');
      if (measure) measure.font = font;
      const textW = measure ? measure.measureText(label).width : label.length * 12;

      const outerPad = 10;
      const insetX = 14;
      const boxH = 52;
      const radius = 6;
      const dotR = 7;
      const gap = 10;
      const boxW = Math.ceil(insetX + dotR * 2 + gap + textW + insetX);
      const w = boxW + outerPad * 2;
      const h = boxH + outerPad * 2;

      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');

      const surface = '#161b22';
      const ink = '#eef0f3';
      const fill = mixHex(accent, surface, 0.82);
      const stroke = mixHex(accent, '#9aa3ad', 0.55);

      const boxX = outerPad;
      const boxY = outerPad;
      const midY = boxY + boxH / 2;
      const dotX = boxX + insetX + dotR;
      const textX = boxX + insetX + dotR * 2 + gap;

      ctx.save();
      ctx.shadowColor = 'rgba(0, 0, 0, 0.28)';
      ctx.shadowBlur = 14;
      ctx.shadowOffsetX = 0;
      ctx.shadowOffsetY = 3;
      ctx.fillStyle = fill;
      roundRectPath(ctx, boxX, boxY, boxW, boxH, radius);
      ctx.fill();
      ctx.restore();

      ctx.fillStyle = fill;
      roundRectPath(ctx, boxX, boxY, boxW, boxH, radius);
      ctx.fill();
      ctx.strokeStyle = stroke;
      ctx.globalAlpha = 0.55;
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.globalAlpha = 1;

      drawStatusSwatch(ctx, status, accent, dotX, midY, dotR);

      ctx.fillStyle = ink;
      ctx.font = font;
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'left';
      ctx.fillText(label, textX, midY + 0.5);

      return {
        width: w,
        height: h,
        data: ctx.getImageData(0, 0, w, h).data
      };
    }

    function buildStatusBadgeIconMatch() {
      const allSubtypes = Object.values(FILTER_GROUPS).flatMap((g) => g.subtypes);
      const expr = ['match', ['get', 'subtype']];
      allSubtypes.forEach((subtype) => {
        expr.push(subtype, [
          'match',
          STATUS_GET_EXPR,
          'operational',
          statusBadgeImageId('operational', subtype),
          'under_construction',
          statusBadgeImageId('under_construction', subtype),
          'planned',
          statusBadgeImageId('planned', subtype),
          'decommissioned',
          statusBadgeImageId('decommissioned', subtype),
          ''
        ]);
      });
      expr.push('');
      return expr;
    }

    /** Card stato: compaiono solo da vicino. */
    const STATUS_BADGE_OPACITY_EXPR = [
      'interpolate',
      ['linear'],
      ['zoom'],
      10.2,
      0,
      11.2,
      0.95,
      13,
      1
    ];

    // Canvas chip @ pixelRatio 2 → ~altezza 26 CSS
    const STATUS_BADGE_SIZE_EXPR = [
      'interpolate',
      ['linear'],
      ['zoom'],
      10,
      0.88,
      12,
      1,
      15,
      1.08
    ];

    // Translate in px: poco sotto il pin
    const STATUS_BADGE_TRANSLATE_EXPR = [
      'interpolate',
      ['linear'],
      ['zoom'],
      10,
      ['literal', [0, 18]],
      12,
      ['literal', [0, 24]],
      15,
      ['literal', [0, 32]]
    ];

    const STATUS_BADGE_LAYERS = [
      'data-centers-status-badges',
      'raw-materials-status-badges',
      'energy-plants-status-badges'
    ];

    const POINT_LAYERS = ['data-centers-layer', 'raw-materials-layer', 'energy-plants-layer'];

    function resetHighlights() {
      ['connections-powers', 'connections-supplies', 'connections-manufactures'].forEach(layerId => {
        if (map.getLayer(layerId)) {
          map.setPaintProperty(layerId, 'line-opacity', 0.7);
          map.setPaintProperty(layerId, 'line-width', 1.6);
        }
      });
      POINT_LAYERS.forEach(layerId => {
        if (map.getLayer(layerId)) {
          map.setLayoutProperty(layerId, 'icon-size', ICON_SIZE_BY_ZOOM);
          map.setPaintProperty(layerId, 'icon-opacity', SITE_ICON_OPACITY_EXPR);
        }
      });
      STATUS_BADGE_LAYERS.forEach(layerId => {
        if (map.getLayer(layerId)) {
          map.setPaintProperty(layerId, 'icon-opacity', STATUS_BADGE_OPACITY_EXPR);
        }
      });
    }

    // Helper: get country name
    function getCountryName(code) {
      return i18n.countries[code] || code;
    }

    // Helper: get subtype label
    function getSubtypeLabel(subtype) {
      return i18n.subtypes[subtype] || subtype;
    }

    // Helper: get relationship label
    function getRelationshipLabel(type) {
      return i18n.relationships[type] || type;
    }

    // Helper: find connections for a feature
    function findConnections(featureId) {
      if (!connectionsData) return { incoming: [], outgoing: [] };
      const incoming = connectionsData.features.filter(f => f.properties.target_id === featureId);
      const outgoing = connectionsData.features.filter(f => f.properties.source_id === featureId);
      return { incoming, outgoing };
    }

    // Helper: highlight connections for a feature (direct edges only)
    function highlightConnections(featureId) {
      if (!connectionsData) return;

      const relatedIds = new Set([featureId]);
      connectionsData.features.forEach(conn => {
        const props = conn.properties;
        if (props.source_id === featureId || props.target_id === featureId) {
          relatedIds.add(props.source_id);
          relatedIds.add(props.target_id);
        }
      });
      const relatedList = Array.from(relatedIds);
      const isDirectEdge = [
        'any',
        ['==', ['get', 'source_id'], featureId],
        ['==', ['get', 'target_id'], featureId]
      ];

      ['connections-powers', 'connections-supplies', 'connections-manufactures'].forEach(layerId => {
        if (!map.getLayer(layerId)) return;
        map.setPaintProperty(layerId, 'line-opacity', ['case', isDirectEdge, 0.95, 0.1]);
        map.setPaintProperty(layerId, 'line-width', ['case', isDirectEdge, 3.4, 0.9]);
      });

      POINT_LAYERS.forEach(layerId => {
        if (!map.getLayer(layerId)) return;
        map.setLayoutProperty(layerId, 'icon-size', [
          'case',
          ['==', ['get', 'id'], featureId],
          ICON_SIZE_HIGHLIGHT_BY_ZOOM,
          ['in', ['get', 'id'], ['literal', relatedList]],
          ICON_SIZE_RELATED_BY_ZOOM,
          ICON_SIZE_DIMMED_BY_ZOOM
        ]);
        map.setPaintProperty(layerId, 'icon-opacity', [
          'case',
          ['==', ['get', 'id'], featureId],
          1,
          ['in', ['get', 'id'], ['literal', relatedList]],
          0.95,
          0.28
        ]);
      });
      STATUS_BADGE_LAYERS.forEach(layerId => {
        if (!map.getLayer(layerId)) return;
        map.setPaintProperty(layerId, 'icon-opacity', [
          'case',
          ['==', ['get', 'id'], featureId],
          1,
          ['in', ['get', 'id'], ['literal', relatedList]],
          0.9,
          0.12
        ]);
      });
    }

    function findSiteById(siteId) {
      const catalogs = [
        ['data_center', dataCentersData],
        ['raw_material', rawMaterialsData],
        ['energy_plant', energyPlantsData]
      ];
      for (const [featureType, collection] of catalogs) {
        if (!collection) continue;
        const match = collection.features.find(f => f.properties.id === siteId);
        if (match) {
          return { featureType, feature: match, properties: match.properties };
        }
      }
      return null;
    }

    function collectRelatedCoordinates(featureId) {
      const coords = [];
      const site = findSiteById(featureId);
      if (site?.feature?.geometry?.coordinates) {
        coords.push(site.feature.geometry.coordinates);
      }
      if (!connectionsData) return coords;
      connectionsData.features.forEach(conn => {
        const props = conn.properties;
        if (props.source_id !== featureId && props.target_id !== featureId) return;
        const otherId = props.source_id === featureId ? props.target_id : props.source_id;
        const other = findSiteById(otherId);
        if (other?.feature?.geometry?.coordinates) {
          coords.push(other.feature.geometry.coordinates);
        }
      });
      return coords;
    }

    function frameSelection(featureId) {
      const coords = collectRelatedCoordinates(featureId);
      if (coords.length === 0) return;

      const isNarrow = window.matchMedia('(max-width: 1023px)').matches;
      const padding = isNarrow
        ? { top: 56, bottom: Math.round(window.innerHeight * 0.4), left: 36, right: 36 }
        : { top: 72, bottom: 72, left: 72, right: 420 };

      if (coords.length === 1) {
        map.easeTo({
          center: coords[0],
          duration: 650,
          padding
        });
        return;
      }

      const bounds = coords.reduce(
        (b, c) => b.extend(c),
        new maplibregl.LngLatBounds(coords[0], coords[0])
      );
      map.fitBounds(bounds, {
        padding,
        maxZoom: 7.5,
        duration: 750
      });
    }

    /** MapLibre stringifies nested props — prefer raw GeoJSON by id. */
    function resolveSiteProperties(mapProps, featureType) {
      const collections = {
        data_center: dataCentersData,
        raw_material: rawMaterialsData,
        energy_plant: energyPlantsData
      };
      const collection = collections[featureType];
      if (collection && mapProps?.id) {
        const match = collection.features.find(f => f.properties.id === mapProps.id);
        if (match) return match.properties;
      }
      return mapProps;
    }

    function resolveConnectionProperties(mapProps) {
      if (connectionsData && mapProps?.id) {
        const match = connectionsData.features.find(f => f.properties.id === mapProps.id);
        if (match) return match.properties;
      }
      return mapProps;
    }

    function formatNumber(value) {
      if (value === null || value === undefined || value === '') return null;
      return typeof value === 'number' ? value.toLocaleString('it-IT') : String(value);
    }

    function formatCompactNumber(value) {
      if (value === null || value === undefined || Number.isNaN(value)) return '—';
      const abs = Math.abs(value);
      if (abs >= 1_000_000) return `${(value / 1_000_000).toLocaleString('it-IT', { maximumFractionDigits: 1 })}M`;
      if (abs >= 10_000) return `${Math.round(value).toLocaleString('it-IT')}`;
      if (abs >= 100) return Math.round(value).toLocaleString('it-IT');
      return value.toLocaleString('it-IT', { maximumFractionDigits: 2 });
    }

    const IMPACT_CARD_LABELS = {
      power: () => i18n.popup.impact_power,
      electricity: () => i18n.popup.impact_electricity,
      co2: () => i18n.popup.impact_co2,
      water: () => i18n.popup.impact_water,
      land: () => i18n.popup.impact_land,
      pue: () => i18n.popup.impact_pue
    };

    function buildImpactHtml(properties, featureType) {
      const api = window.SubstratoImpact;
      const impact = properties?.impact;
      const model = api?.buildImpactModel
        ? api.buildImpactModel({
            impact: impact || null,
            capacityLabel: properties?.capacity || null,
            country: properties?.country || null,
            siteKind: featureType,
            subtype: properties?.subtype || null
          })
        : null;

      const hasCards = model && model.cards && model.cards.length > 0;
      const hasNote = !!(impact && impact.energy_mix_note_it);
      if (!hasCards && !hasNote && !impact) return '';

      let html = `<div class="detail-section detail-impact"><h4>${i18n.popup.impact}</h4>`;

      if (!hasCards && !hasNote) {
        html += `<p class="detail-empty">${i18n.popup.impact_empty}</p>`;
        html += '</div>';
        return html;
      }

      if (hasCards) {
        html += `<div class="impact-cards">`;
        model.cards.forEach((card) => {
          const label = (IMPACT_CARD_LABELS[card.id] || (() => card.id))();
          const badge =
            card.origin === 'declared'
              ? i18n.popup.impact_badge_declared
              : i18n.popup.impact_badge_estimated;
          const badgeClass = card.origin === 'declared' ? 'is-declared' : 'is-estimated';
          let equiv = '';
          if (card.equiv && card.equiv.kind === 'households') {
            equiv = `<div class="impact-card-equiv">${i18n.popup.impact_equiv_households.replace(
              '{n}',
              formatCompactNumber(card.equiv.value)
            )}</div>`;
          }
          html += `<div class="impact-card impact-card-${card.id}">
            <div class="impact-card-top">
              <span class="impact-card-label">${label}</span>
              <span class="impact-card-badge ${badgeClass}">${badge}</span>
            </div>
            <div class="impact-card-value">${formatCompactNumber(card.value)}<span class="impact-card-unit">${card.unit}</span></div>
            ${equiv}
          </div>`;
        });
        html += `</div>`;
        if (model.cards.some((c) => c.origin === 'estimated')) {
          html += `<p class="impact-disclaimer">${i18n.popup.impact_disclaimer}</p>`;
        }
      }

      if (hasNote) {
        html += `<div class="detail-field">
          <div class="detail-field-label">${i18n.popup.energy_mix}</div>
          <div class="detail-field-value">${impact.energy_mix_note_it}</div>
        </div>`;
      }
      html += '</div>';
      return html;
    }

    function buildSourcesHtml(sources) {
      if (!Array.isArray(sources) || sources.length === 0) return '';
      let html = `<div class="detail-section">
        <h4>${i18n.popup.sources}</h4>
        <ul class="detail-sources">`;
      sources.forEach(src => {
        const title = src.url
          ? `<a href="${src.url}" target="_blank" rel="noopener noreferrer">${src.title}</a>`
          : src.title;
        const meta = [src.accessed_at, src.note].filter(Boolean).join(' — ');
        html += `<li>${title}${meta ? `<span class="detail-source-meta">${meta}</span>` : ''}</li>`;
      });
      html += '</ul></div>';
      return html;
    }

    function laborTagLabel(code) {
      return (i18n.labor_tags && i18n.labor_tags[code]) || code;
    }

    function buildEmploymentHtml(properties) {
      const emp = properties.employment;
      const risks = properties.labor_risks;
      const community = properties.community_impact_it;
      if (!emp && !(risks && risks.length) && !community) return '';

      let html = '';

      if (emp || (Array.isArray(risks) && risks.length)) {
        html += `<div class="detail-section detail-employment"><h4>${i18n.popup.employment}</h4>`;
        if (i18n.popup.labor_contrast) {
          html += `<p class="detail-labor-contrast">${i18n.popup.labor_contrast}</p>`;
        }
        if (emp) {
          const rows = [
            [i18n.popup.jobs_direct, formatNumber(emp.direct)],
            [i18n.popup.jobs_indirect, formatNumber(emp.indirect_est)],
            [i18n.popup.jobs_contractors, formatNumber(emp.contractors_est)]
          ].filter(([, v]) => v !== null);
          rows.forEach(([label, value]) => {
            html += `<div class="detail-field">
              <div class="detail-field-label">${label}</div>
              <div class="detail-field-value">${value}</div>
            </div>`;
          });
          if (emp.note_it) {
            html += `<p class="detail-note">${emp.note_it}</p>`;
          }
          if (Array.isArray(emp.conditions_tags) && emp.conditions_tags.length) {
            html += `<div class="detail-field">
              <div class="detail-field-label">${i18n.popup.labor_conditions || 'Condizioni'}</div>
              <div class="detail-tags">${emp.conditions_tags.map(t =>
                `<span class="detail-tag">${laborTagLabel(t)}</span>`
              ).join('')}</div>
            </div>`;
          }
        }
        if (Array.isArray(risks) && risks.length) {
          html += `<div class="detail-field">
            <div class="detail-field-label">${i18n.popup.labor_risks}</div>
            <div class="detail-tags">${risks.map(t =>
              `<span class="detail-tag detail-tag-risk">${laborTagLabel(t)}</span>`
            ).join('')}</div>
          </div>`;
        }
        html += '</div>';
      }

      if (community) {
        html += `<div class="detail-section detail-community">
          <h4>${i18n.popup.community}</h4>
          <p class="detail-community-body">${community}</p>
        </div>`;
      }

      return html;
    }

    // Build detail sidebar HTML for a point feature
    function buildPointDetail(properties, featureType) {
      const accentColor =
        (properties.subtype && SUBTYPE_COLORS[properties.subtype]) ||
        (featureType === 'data_center' ? COLORS.dc :
          featureType === 'raw_material' ? COLORS.rm : COLORS.ep);
      const shapeClass = featureType === 'data_center' ? '' :
                         featureType === 'raw_material' ? 'shape-rm' : 'shape-ep';
      const typeLabel = featureType === 'data_center' ? i18n.layers.data_centers :
                        featureType === 'raw_material' ? i18n.layers.raw_materials :
                        i18n.layers.energy_plants;

      const place = [properties.city, getCountryName(properties.country)].filter(Boolean).join(', ');
      let html = '';

      if (place) {
        html += `<p class="detail-place">${place}</p>`;
      }

      if (properties.description_it) {
        html += `<p class="detail-description">${properties.description_it}</p>`;
      }

      const facts = [];
      if (properties.operator) facts.push({ label: i18n.popup.operator, value: properties.operator });
      if (properties.subtype) facts.push({ label: i18n.popup.type, value: getSubtypeLabel(properties.subtype) });
      if (properties.status && i18n.status[properties.status]) {
        facts.push({ label: i18n.popup.status, value: i18n.status[properties.status] });
      }
      if (properties.capacity) facts.push({ label: i18n.popup.capacity, value: properties.capacity });

      if (facts.length) {
        html += `<div class="detail-facts">`;
        facts.forEach(({ label, value }) => {
          html += `<div class="detail-fact">
            <span class="detail-fact-label">${label}</span>
            <span class="detail-fact-value">${value}</span>
          </div>`;
        });
        html += `</div>`;
      }

      // Connections — early, actionable
      const { incoming, outgoing } = findConnections(properties.id);
      const connBlocks = [];

      function pushConnGroup(label, items, iconClass, pickOtherId) {
        if (!items.length) return;
        let block = `<div class="detail-conn-group">
          <div class="detail-field-label">${label}</div>`;
        items.forEach(c => {
          const otherId = pickOtherId(c.properties);
          const other = findSiteById(otherId);
          const name = otherId === c.properties.source_id
            ? c.properties.source_name
            : c.properties.target_name;
          if (other) {
            block += `<button type="button" class="detail-connection-item is-action"
              data-site-id="${otherId}"
              title="${i18n.popup.open_connected}">
              <span class="detail-connection-icon ${iconClass}"></span>
              <span class="detail-connection-label">${name}</span>
              <span class="detail-connection-go" aria-hidden="true">→</span>
            </button>`;
          } else {
            block += `<div class="detail-connection-item">
              <span class="detail-connection-icon ${iconClass}"></span>
              <span class="detail-connection-label">${name}</span>
            </div>`;
          }
        });
        block += '</div>';
        connBlocks.push(block);
      }

      if (featureType === 'data_center') {
        pushConnGroup(
          i18n.popup.powered_by,
          incoming.filter(c => c.properties.relationship_type === 'powers'),
          'is-power',
          p => p.source_id
        );
        pushConnGroup(
          i18n.popup.components_from,
          incoming.filter(c => c.properties.relationship_type === 'manufactures_for'),
          'is-mfg',
          p => p.source_id
        );
        pushConnGroup(
          i18n.popup.supplies_from || i18n.popup.receives_from,
          incoming.filter(c => c.properties.relationship_type === 'supplies'),
          'is-supply',
          p => p.source_id
        );
      } else if (featureType === 'raw_material') {
        pushConnGroup(
          i18n.popup.supplies_to,
          outgoing.filter(c => c.properties.relationship_type === 'supplies'),
          'is-supply',
          p => p.target_id
        );
        pushConnGroup(
          i18n.popup.manufactures_to || i18n.popup.supplies_to,
          outgoing.filter(c => c.properties.relationship_type === 'manufactures_for'),
          'is-mfg',
          p => p.target_id
        );
        pushConnGroup(
          i18n.popup.receives_from,
          incoming,
          'is-supply',
          p => p.source_id
        );
      } else if (featureType === 'energy_plant') {
        pushConnGroup(i18n.popup.powers_to, outgoing, 'is-power', p => p.target_id);
      }

      if (connBlocks.length) {
        html += `<div class="detail-connections">
          <h4>${i18n.popup.connections}</h4>
          <p class="detail-connections-hint">${i18n.popup.connections_hint}</p>
          ${connBlocks.join('')}
        </div>`;
      }

      html += buildImpactHtml(properties, featureType);
      html += buildEmploymentHtml(properties);
      html += buildSourcesHtml(properties.sources);

      const metaBits = [];
      if (properties.confidence && i18n.confidence[properties.confidence]) {
        metaBits.push(
          `<span class="certainty-badge certainty-${properties.confidence}">${i18n.confidence[properties.confidence]}</span>`
        );
      }
      if (properties.updated_at) {
        metaBits.push(`<span>${i18n.popup.updated_at} ${properties.updated_at}</span>`);
      }
      if (metaBits.length) {
        html += `<div class="detail-meta">${metaBits.join('')}</div>`;
      }

      return { html, accentColor, shapeClass, typeLabel };
    }

    // Open detail sidebar for a point feature
    function openPointDetail(properties, featureType, options = {}) {
      const resolved = resolveSiteProperties(properties, featureType);
      const { html, accentColor, shapeClass, typeLabel } = buildPointDetail(resolved, featureType);
      detailTitle.textContent = resolved.name;
      detailSidebar.style.setProperty('--accent', accentColor);
      if (detailType) {
        detailType.hidden = false;
        detailType.innerHTML = `<i class="${shapeClass}"></i>${typeLabel}`;
      }
      detailBody.innerHTML = html;
      detailSidebar.classList.add('open');
      detailSidebar.classList.remove('is-pulse');
      void detailSidebar.offsetWidth;
      detailSidebar.classList.add('is-pulse');
      document.body.classList.add('detail-open');
      document.body.classList.remove('filters-open');
      document.body.classList.remove('search-open');
      const filtersToggle = document.getElementById('filters-toggle');
      if (filtersToggle) filtersToggle.setAttribute('aria-expanded', 'false');
      const searchToggleBtn = document.getElementById('map-search-toggle');
      if (searchToggleBtn) searchToggleBtn.setAttribute('aria-expanded', 'false');
      highlightConnections(resolved.id);
      if (options.frame !== false) frameSelection(resolved.id);
      window.SubstratoMapChrome?.dismissMapHint?.();
      hideTooltip();

      detailBody.querySelectorAll('[data-site-id]').forEach(btn => {
        btn.addEventListener('click', () => {
          const siteId = btn.getAttribute('data-site-id');
          const site = findSiteById(siteId);
          if (!site) return;
          openPointDetail(site.properties, site.featureType);
        });
      });
    }

    function connAccent(relType) {
      if (relType === 'powers') return COLORS.ep;
      if (relType === 'supplies') return COLORS.rm;
      return COLORS.dc;
    }

    function connIconClass(relType) {
      if (relType === 'powers') return 'is-power';
      if (relType === 'supplies') return 'is-supply';
      return 'is-mfg';
    }

    function highlightConnectionEdge(props) {
      const pair = [props.source_id, props.target_id];
      const isThisEdge = props.id
        ? ['==', ['get', 'id'], props.id]
        : [
            'all',
            ['==', ['get', 'source_id'], props.source_id],
            ['==', ['get', 'target_id'], props.target_id]
          ];
      ['connections-powers', 'connections-supplies', 'connections-manufactures'].forEach(layerId => {
        if (!map.getLayer(layerId)) return;
        map.setPaintProperty(layerId, 'line-opacity', ['case', isThisEdge, 0.95, 0.1]);
        map.setPaintProperty(layerId, 'line-width', ['case', isThisEdge, 3.6, 0.9]);
      });
      POINT_LAYERS.forEach(layerId => {
        if (!map.getLayer(layerId)) return;
        map.setLayoutProperty(layerId, 'icon-size', [
          'case',
          ['in', ['get', 'id'], ['literal', pair]],
          ICON_SIZE_HIGHLIGHT_BY_ZOOM,
          ICON_SIZE_DIMMED_BY_ZOOM
        ]);
        map.setPaintProperty(layerId, 'icon-opacity', [
          'case',
          ['in', ['get', 'id'], ['literal', pair]],
          1,
          0.28
        ]);
      });
      STATUS_BADGE_LAYERS.forEach(layerId => {
        if (!map.getLayer(layerId)) return;
        map.setPaintProperty(layerId, 'icon-opacity', [
          'case',
          ['in', ['get', 'id'], ['literal', pair]],
          1,
          0.12
        ]);
      });
    }

    function frameConnection(props) {
      const coords = [];
      [props.source_id, props.target_id].forEach((id) => {
        const site = findSiteById(id);
        if (site?.feature?.geometry?.coordinates) {
          coords.push(site.feature.geometry.coordinates);
        }
      });
      if (coords.length === 0) return;

      const isNarrow = window.matchMedia('(max-width: 1023px)').matches;
      const padding = isNarrow
        ? { top: 56, bottom: Math.round(window.innerHeight * 0.4), left: 36, right: 36 }
        : { top: 72, bottom: 72, left: 72, right: 420 };

      if (coords.length === 1) {
        map.easeTo({ center: coords[0], duration: 650, padding });
        return;
      }

      const bounds = coords.reduce(
        (b, c) => b.extend(c),
        new maplibregl.LngLatBounds(coords[0], coords[0])
      );
      map.fitBounds(bounds, {
        padding,
        maxZoom: 7.5,
        duration: 750
      });
    }

    function buildConnectionDetail(props) {
      const relType = props.relationship_type;
      const accentColor = connAccent(relType);
      const iconClass = connIconClass(relType);
      const typeLabel = i18n.layers.connections;

      let html = '';

      if (props.certainty && i18n.certainty[props.certainty]) {
        html += `<div class="detail-facts">
          <div class="detail-fact">
            <span class="detail-fact-label">${i18n.popup.certainty}</span>
            <span class="detail-fact-value">
              <span class="certainty-badge certainty-${props.certainty}">${i18n.certainty[props.certainty]}</span>
            </span>
          </div>
        </div>`;
      }

      if (props.description_it) {
        html += `<p class="detail-description">${escapeHtml(props.description_it)}</p>`;
      }

      if (props.evidence_note_it) {
        html += `<div class="detail-section">
          <h4>${i18n.popup.evidence}</h4>
          <p class="detail-description detail-evidence">${escapeHtml(props.evidence_note_it)}</p>
        </div>`;
      }

      html += `<div class="detail-section detail-conn-endpoints">
        <h4>${i18n.popup.linked_sites}</h4>
        <p class="detail-connections-hint">${i18n.popup.connections_hint}</p>
        <button type="button" class="detail-connection-item is-action"
          data-site-id="${escapeHtml(props.source_id)}"
          title="${i18n.popup.open_connected}">
          <span class="detail-connection-icon ${iconClass}"></span>
          <span class="detail-connection-label">${escapeHtml(props.source_name || props.source_id)}</span>
          <span class="detail-connection-go" aria-hidden="true">→</span>
        </button>
        <button type="button" class="detail-connection-item is-action"
          data-site-id="${escapeHtml(props.target_id)}"
          title="${i18n.popup.open_connected}">
          <span class="detail-connection-icon ${iconClass}"></span>
          <span class="detail-connection-label">${escapeHtml(props.target_name || props.target_id)}</span>
          <span class="detail-connection-go" aria-hidden="true">→</span>
        </button>
      </div>`;

      html += buildSourcesHtml(props.sources);

      if (props.updated_at) {
        html += `<div class="detail-meta">
          <span>${i18n.popup.updated_at} ${escapeHtml(props.updated_at)}</span>
        </div>`;
      }

      return {
        html,
        accentColor,
        typeLabel,
        title: getRelationshipLabel(relType)
      };
    }

    function openConnectionDetail(properties, options = {}) {
      const props = resolveConnectionProperties(properties);
      const { html, accentColor, typeLabel, title } = buildConnectionDetail(props);

      detailTitle.textContent = title;
      detailSidebar.style.setProperty('--accent', accentColor);
      if (detailType) {
        detailType.hidden = false;
        detailType.innerHTML =
          `<span class="detail-type-conn-swatch" aria-hidden="true"></span>${typeLabel}`;
      }
      detailBody.innerHTML = html;
      detailSidebar.classList.add('open');
      detailSidebar.classList.remove('is-pulse');
      void detailSidebar.offsetWidth;
      detailSidebar.classList.add('is-pulse');
      document.body.classList.add('detail-open');
      document.body.classList.remove('filters-open');
      document.body.classList.remove('search-open');
      const filtersToggle = document.getElementById('filters-toggle');
      if (filtersToggle) filtersToggle.setAttribute('aria-expanded', 'false');
      const searchToggleBtn = document.getElementById('map-search-toggle');
      if (searchToggleBtn) searchToggleBtn.setAttribute('aria-expanded', 'false');

      highlightConnectionEdge(props);
      if (options.frame !== false) frameConnection(props);
      window.SubstratoMapChrome?.dismissMapHint?.();
      hideTooltip();

      detailBody.querySelectorAll('[data-site-id]').forEach(btn => {
        btn.addEventListener('click', () => {
          const siteId = btn.getAttribute('data-site-id');
          const site = findSiteById(siteId);
          if (!site) return;
          openPointDetail(site.properties, site.featureType);
        });
      });
    }

    // Hover preview (sites) + plain tooltip (lines / overlays)
    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function positionTooltip(e) {
      const pad = 12;
      const x = e.point.x;
      const y = e.point.y;
      tooltip.style.left = x + 'px';
      tooltip.style.top = y + 'px';
      // Sopra il cursore di default; sotto se troppo vicino al bordo alto
      if (y < 96) {
        tooltip.style.transform = 'translate(-50%, 16px)';
      } else {
        tooltip.style.transform = 'translate(-50%, calc(-100% - 14px))';
      }
      // Evita overflow orizzontale grezzo
      requestAnimationFrame(() => {
        const rect = tooltip.getBoundingClientRect();
        const mapEl = document.getElementById('map');
        if (!mapEl) return;
        const mapRect = mapEl.getBoundingClientRect();
        let shift = 0;
        if (rect.left < mapRect.left + pad) shift = mapRect.left + pad - rect.left;
        else if (rect.right > mapRect.right - pad) shift = mapRect.right - pad - rect.right;
        if (shift) {
          tooltip.style.left = x + shift + 'px';
        }
      });
    }

    function showTooltip(e, text) {
      tooltip.classList.remove('is-site', 'is-conn');
      tooltip.classList.add('is-plain');
      tooltip.textContent = text;
      positionTooltip(e);
      tooltip.classList.add('visible');
    }

    function showSitePreview(e, properties, featureType) {
      const statusKey = properties.status && STATUS_COLORS[properties.status]
        ? properties.status
        : 'unknown';
      const statusColor = STATUS_COLORS[statusKey] || STATUS_COLORS.unknown;
      const statusText =
        STATUS_SHORT_LABELS[statusKey] ||
        i18n.status[statusKey] ||
        statusKey;
      const accent =
        (properties.subtype && SUBTYPE_COLORS[properties.subtype]) ||
        (featureType === 'data_center' ? COLORS.dc :
          featureType === 'raw_material' ? COLORS.rm : COLORS.ep);
      const typeText = properties.subtype
        ? getSubtypeLabel(properties.subtype)
        : (featureType === 'data_center' ? i18n.layers.data_centers :
            featureType === 'raw_material' ? i18n.layers.raw_materials :
            i18n.layers.energy_plants);
      const place = [properties.city, getCountryName(properties.country)]
        .filter(Boolean)
        .join(', ');
      const metaParts = [];
      if (properties.operator) metaParts.push(properties.operator);
      if (place) metaParts.push(place);
      const meta = metaParts.join(' · ');

      tooltip.classList.remove('is-plain', 'is-conn');
      tooltip.classList.add('is-site');
      tooltip.style.setProperty('--tooltip-accent', accent);
      tooltip.innerHTML =
        `<p class="map-tooltip-title">${escapeHtml(properties.name || '')}</p>` +
        `<div class="map-tooltip-row">` +
          `<span class="map-tooltip-type">` +
            `<span class="map-tooltip-type-dot" aria-hidden="true"></span>` +
            `${escapeHtml(typeText)}` +
          `</span>` +
          `<span class="map-tooltip-status" style="--chip-color: ${statusColor};">` +
            `<span class="status-swatch status-${statusKey}" aria-hidden="true"></span>` +
            `${escapeHtml(statusText)}` +
          `</span>` +
        `</div>` +
        (meta ? `<p class="map-tooltip-meta">${escapeHtml(meta)}</p>` : '') +
        (properties.capacity
          ? `<p class="map-tooltip-cap">${escapeHtml(properties.capacity)}</p>`
          : '');

      positionTooltip(e);
      tooltip.classList.add('visible');
    }

    function showConnectionPreview(e, mapProps) {
      const props = resolveConnectionProperties(mapProps);
      const relType = props.relationship_type || '';
      const typeColor =
        relType === 'powers' ? COLORS.ep :
        relType === 'supplies' ? COLORS.rm :
        COLORS.dc;
      const typeLabel = getRelationshipLabel(relType);
      const certaintyKey = props.certainty;
      const certaintyLabel =
        certaintyKey && i18n.certainty[certaintyKey]
          ? i18n.certainty[certaintyKey]
          : '';

      tooltip.classList.remove('is-plain');
      tooltip.classList.add('is-site', 'is-conn');
      tooltip.style.setProperty('--tooltip-accent', typeColor);
      tooltip.innerHTML =
        `<div class="map-tooltip-route">` +
          `<span class="map-tooltip-route-from">${escapeHtml(props.source_name || '')}</span>` +
          `<span class="map-tooltip-route-arrow" aria-hidden="true">→</span>` +
          `<span class="map-tooltip-route-to">${escapeHtml(props.target_name || '')}</span>` +
        `</div>` +
        `<div class="map-tooltip-row">` +
          `<span class="map-tooltip-type" style="--tooltip-accent: ${typeColor};">` +
            `<span class="map-tooltip-conn-swatch" aria-hidden="true"></span>` +
            `${escapeHtml(typeLabel)}` +
          `</span>` +
          (certaintyLabel
            ? `<span class="certainty-badge certainty-${escapeHtml(certaintyKey)}">${escapeHtml(certaintyLabel)}</span>`
            : '') +
        `</div>`;

      positionTooltip(e);
      tooltip.classList.add('visible');
    }

    function hideTooltip() {
      tooltip.classList.remove('visible');
    }

    // Load data and add layers
    map.on('load', async () => {
      // Fetch all GeoJSON data
      const [dcRes, rmRes, epRes, connRes] = await Promise.all([
        fetch('/data/data_centers.geojson'),
        fetch('/data/raw_materials.geojson'),
        fetch('/data/energy_plants.geojson'),
        fetch('/data/connections.geojson')
      ]);

      dataCentersData = await dcRes.json();
      rawMaterialsData = await rmRes.json();
      energyPlantsData = await epRes.json();
      connectionsData = await connRes.json();

      // Assicura IBM Plex Sans prima di rasterizzare le card (canvas non ha CSS fallback)
      try {
        if (document.fonts?.load) {
          await document.fonts.load('600 22px "IBM Plex Sans"');
        }
      } catch (_) {
        /* fallback Helvetica se il font non è ancora disponibile */
      }

      // Marker icons by subtype × status (pieno / cantiere / fantasma / disattivato)
      Object.values(FILTER_GROUPS).forEach((group) => {
        group.subtypes.forEach((subtype) => {
          const path = ICON_PATHS[subtype];
          if (!path) return;
          const color = SUBTYPE_COLORS[subtype] || group.color;
          ICON_STATUS_STYLES.forEach((style) => {
            const id = iconImageId(subtype, style);
            if (!map.hasImage(id)) {
              map.addImage(
                id,
                createMapIconImage(path, color, ICON_CANVAS_SIZE, style),
                { pixelRatio: ICON_PIXEL_RATIO }
              );
            }
          });
        });
      });

      // Chip stato: stile allineato ai filter-chip (status × label)
      ['operational', 'under_construction', 'planned', 'decommissioned'].forEach((status) => {
        Object.values(FILTER_GROUPS).forEach((group) => {
          group.subtypes.forEach((subtype) => {
            const id = statusBadgeImageId(status, subtype);
            if (!map.hasImage(id)) {
              map.addImage(
                id,
                createStatusBadgeImage(
                  status,
                  STATUS_SHORT_LABELS[status],
                  STATUS_COLORS[status]
                ),
                { pixelRatio: STATUS_BADGE_PIXEL_RATIO }
              );
            }
          });
        });
      });

      // Add sources
      map.addSource('data-centers', { type: 'geojson', data: dataCentersData });
      map.addSource('raw-materials', { type: 'geojson', data: rawMaterialsData });
      map.addSource('energy-plants', { type: 'geojson', data: energyPlantsData });
      map.addSource('connections', { type: 'geojson', data: connectionsData });

      // Context overlays (below site layers)
      map.addSource('openinframap-power', {
        type: 'vector',
        tiles: ['https://openinframap.org/tiles/{z}/{x}/{y}.pbf'],
        maxzoom: 17,
        attribution: '© OpenStreetMap, OpenInfraMap'
      });

      const [cablesRes, landingsRes, waterRes] = await Promise.all([
        fetch('/data/overlays/submarine_cables.geojson'),
        fetch('/data/overlays/cable_landings.geojson'),
        fetch('/data/overlays/water_stress_eu.geojson')
      ]);
      const cablesData = await cablesRes.json();
      const landingsData = await landingsRes.json();
      const waterData = await waterRes.json();

      map.addSource('overlay-cables', { type: 'geojson', data: cablesData });
      map.addSource('overlay-landings', { type: 'geojson', data: landingsData });
      map.addSource('overlay-water', { type: 'geojson', data: waterData });

      map.addLayer({
        id: 'overlay-water-fill',
        type: 'fill',
        source: 'overlay-water',
        layout: { visibility: 'none' },
        paint: {
          'fill-color': [
            'interpolate',
            ['linear'],
            ['get', 'bws_cat'],
            0, '#c8ddd4',
            1, '#e8d9a8',
            2, '#e0b07a',
            3, '#c97a5a',
            4, '#8f3d4a'
          ],
          'fill-opacity': 0.38
        }
      });

      map.addLayer({
        id: 'overlay-water-outline',
        type: 'line',
        source: 'overlay-water',
        layout: { visibility: 'none' },
        paint: {
          'line-color': '#6a5a4a',
          'line-width': 0.4,
          'line-opacity': 0.2
        }
      });

      map.addLayer({
        id: 'overlay-power-lines',
        type: 'line',
        source: 'openinframap-power',
        'source-layer': 'power_line',
        layout: {
          visibility: 'none',
          'line-cap': 'round',
          'line-join': 'round'
        },
        paint: {
          'line-color': [
            'interpolate',
            ['linear'],
            ['coalesce', ['to-number', ['get', 'voltage']], 0],
            0, '#b8a48a',
            110000, '#9a7a4a',
            220000, '#7a5a2e',
            400000, '#5a3a18'
          ],
          'line-width': [
            'interpolate',
            ['linear'],
            ['zoom'],
            4, 0.4,
            8, 1.1,
            12, 2.2
          ],
          'line-opacity': 0.75
        }
      });

      map.addLayer({
        id: 'overlay-cables-line',
        type: 'line',
        source: 'overlay-cables',
        layout: { visibility: 'none', 'line-cap': 'round', 'line-join': 'round' },
        paint: {
          'line-color': '#3d6f8c',
          'line-width': [
            'interpolate',
            ['linear'],
            ['zoom'],
            3, 0.8,
            8, 1.6,
            12, 2.4
          ],
          'line-opacity': 0.7
        }
      });

      map.addLayer({
        id: 'overlay-cable-landings',
        type: 'circle',
        source: 'overlay-landings',
        layout: { visibility: 'none' },
        paint: {
          'circle-radius': [
            'interpolate',
            ['linear'],
            ['zoom'],
            3, 2.5,
            8, 4,
            12, 6
          ],
          'circle-color': '#3d6f8c',
          'circle-stroke-width': 1,
          'circle-stroke-color': '#ffffff',
          'circle-opacity': 0.85
        }
      });

      // Add connection line layers (below points)
      map.addLayer({
        id: 'connections-powers',
        type: 'line',
        source: 'connections',
        filter: ['==', ['get', 'relationship_type'], 'powers'],
        paint: {
          'line-color': COLORS.ep,
          'line-width': 1.6,
          'line-dasharray': [2, 2.5],
          'line-opacity': 0.7
        }
      });

      map.addLayer({
        id: 'connections-supplies',
        type: 'line',
        source: 'connections',
        filter: ['==', ['get', 'relationship_type'], 'supplies'],
        paint: {
          'line-color': COLORS.rm,
          'line-width': 1.6,
          'line-dasharray': [1.5, 2.5],
          'line-opacity': 0.7
        }
      });

      map.addLayer({
        id: 'connections-manufactures',
        type: 'line',
        source: 'connections',
        filter: ['==', ['get', 'relationship_type'], 'manufactures_for'],
        paint: {
          'line-color': COLORS.dc,
          'line-width': 1.6,
          'line-dasharray': [4, 3],
          'line-opacity': 0.7
        }
      });

      const pointLayerPaint = {
        'icon-opacity': SITE_ICON_OPACITY_EXPR
      };

      const pointLayerLayout = {
        'icon-size': ICON_SIZE_BY_ZOOM,
        'icon-allow-overlap': true,
        'icon-ignore-placement': true
      };

      const statusBadgeLayout = {
        'icon-image': buildStatusBadgeIconMatch(),
        'icon-size': STATUS_BADGE_SIZE_EXPR,
        'icon-anchor': 'top',
        'icon-offset': ['literal', [0, 0]],
        'icon-allow-overlap': true,
        'icon-ignore-placement': true,
        'icon-padding': 4
      };

      const statusBadgePaint = {
        'icon-opacity': STATUS_BADGE_OPACITY_EXPR,
        'icon-translate': STATUS_BADGE_TRANSLATE_EXPR,
        'icon-translate-anchor': 'viewport'
      };

      const statusBadgeFilterBase = [
        'in',
        STATUS_GET_EXPR,
        ['literal', ['operational', 'under_construction', 'planned', 'decommissioned']]
      ];

      // Card sotto i pin (prima delle icone, così il pin resta sopra)
      map.addLayer({
        id: 'data-centers-status-badges',
        type: 'symbol',
        source: 'data-centers',
        filter: statusBadgeFilterBase,
        layout: statusBadgeLayout,
        paint: statusBadgePaint
      });

      map.addLayer({
        id: 'raw-materials-status-badges',
        type: 'symbol',
        source: 'raw-materials',
        filter: statusBadgeFilterBase,
        layout: statusBadgeLayout,
        paint: statusBadgePaint
      });

      map.addLayer({
        id: 'energy-plants-status-badges',
        type: 'symbol',
        source: 'energy-plants',
        filter: statusBadgeFilterBase,
        layout: statusBadgeLayout,
        paint: statusBadgePaint
      });

      // Point layers — silhouette per sottotipo + variante di stato
      map.addLayer({
        id: 'data-centers-layer',
        type: 'symbol',
        source: 'data-centers',
        layout: {
          ...pointLayerLayout,
          'icon-image': buildStatusAwareIconMatch(
            FILTER_GROUPS.data_centers.subtypes,
            'hyperscale'
          )
        },
        paint: pointLayerPaint
      });

      map.addLayer({
        id: 'raw-materials-layer',
        type: 'symbol',
        source: 'raw-materials',
        layout: {
          ...pointLayerLayout,
          'icon-image': buildStatusAwareIconMatch(
            FILTER_GROUPS.raw_materials.subtypes,
            'lithium_mine'
          )
        },
        paint: pointLayerPaint
      });

      map.addLayer({
        id: 'energy-plants-layer',
        type: 'symbol',
        source: 'energy-plants',
        layout: {
          ...pointLayerLayout,
          'icon-image': buildStatusAwareIconMatch(
            FILTER_GROUPS.energy_plants.subtypes,
            'gas'
          )
        },
        paint: pointLayerPaint
      });

      // --- Interactivity ---

      const pointLayers = ['data-centers-layer', 'raw-materials-layer', 'energy-plants-layer'];
      const connectionLayers = ['connections-powers', 'connections-supplies', 'connections-manufactures'];
      const allInteractiveLayers = [...pointLayers, ...connectionLayers];
      const connLayerByRel = {
        powers: 'connections-powers',
        supplies: 'connections-supplies',
        manufactures_for: 'connections-manufactures'
      };

      // Cursor pointer on hover
      allInteractiveLayers.forEach(layerId => {
        map.on('mouseenter', layerId, () => {
          map.getCanvas().style.cursor = 'pointer';
        });
        map.on('mouseleave', layerId, () => {
          map.getCanvas().style.cursor = '';
          hideTooltip();
        });
      });

      // Hover preview for site pins
      const siteHoverLayers = [
        { layerId: 'data-centers-layer', featureType: 'data_center' },
        { layerId: 'raw-materials-layer', featureType: 'raw_material' },
        { layerId: 'energy-plants-layer', featureType: 'energy_plant' }
      ];
      siteHoverLayers.forEach(({ layerId, featureType }) => {
        map.on('mousemove', layerId, (e) => {
          if (e.features && e.features.length > 0) {
            showSitePreview(e, e.features[0].properties, featureType);
          }
        });
        map.on('mouseleave', layerId, () => {
          hideTooltip();
        });
      });

      // Hover preview for connections
      connectionLayers.forEach(layerId => {
        map.on('mousemove', layerId, (e) => {
          if (e.features && e.features.length > 0) {
            showConnectionPreview(e, e.features[0].properties);
          }
        });
        map.on('mouseleave', layerId, () => {
          hideTooltip();
        });
      });

      // Click on data center points
      map.on('click', 'data-centers-layer', (e) => {
        if (e.features && e.features.length > 0) {
          const properties = e.features[0].properties;
          openPointDetail(properties, 'data_center');
          e.originalEvent.stopPropagation();
        }
      });

      // Click on raw material points
      map.on('click', 'raw-materials-layer', (e) => {
        if (e.features && e.features.length > 0) {
          const properties = e.features[0].properties;
          openPointDetail(properties, 'raw_material');
          e.originalEvent.stopPropagation();
        }
      });

      // Click on energy plant points
      map.on('click', 'energy-plants-layer', (e) => {
        if (e.features && e.features.length > 0) {
          const properties = e.features[0].properties;
          openPointDetail(properties, 'energy_plant');
          e.originalEvent.stopPropagation();
        }
      });

      // Click on connection lines
      connectionLayers.forEach(layerId => {
        map.on('click', layerId, (e) => {
          if (e.features && e.features.length > 0) {
            openConnectionDetail(e.features[0].properties);
            e.originalEvent.stopPropagation();
          }
        });
      });

      // Click on map background to close sidebar
      map.on('click', (e) => {
        // Check if click was on any interactive layer
        const features = map.queryRenderedFeatures(e.point, { layers: allInteractiveLayers });
        if (features.length === 0) {
          closeDetailSidebar();
        }
      });

      // --- Filters ---
      const filterState = {
        data_centers: { subtypes: new Set(FILTER_GROUPS.data_centers.subtypes) },
        energy_plants: { subtypes: new Set(FILTER_GROUPS.energy_plants.subtypes) },
        raw_materials: { subtypes: new Set(FILTER_GROUPS.raw_materials.subtypes) },
        connections: { types: new Set(CONNECTION_TYPES) },
        status: new Set(SITE_STATUSES)
      };

      const dataByGroup = {
        data_centers: () => dataCentersData,
        energy_plants: () => energyPlantsData,
        raw_materials: () => rawMaterialsData,
        connections: () => connectionsData
      };

      function featureStatus(props) {
        return props?.status || 'unknown';
      }

      function matchesStatus(props) {
        return filterState.status.has(featureStatus(props));
      }

      function siteLayerFilter(gid) {
        const subtypes = Array.from(filterState[gid].subtypes);
        const statuses = Array.from(filterState.status);
        return [
          'all',
          ['in', ['get', 'subtype'], ['literal', subtypes]],
          ['in', STATUS_GET_EXPR, ['literal', statuses]]
        ];
      }

      function countVisible(groupId) {
        const data = dataByGroup[groupId]();
        if (!data) return 0;
        if (groupId === 'connections') {
          return data.features.filter(f =>
            filterState.connections.types.has(f.properties.relationship_type)
          ).length;
        }
        const state = filterState[groupId];
        return data.features.filter(
          f => state.subtypes.has(f.properties.subtype) && matchesStatus(f.properties)
        ).length;
      }

      function countStatusVisible() {
        let n = 0;
        ['data_centers', 'energy_plants', 'raw_materials'].forEach((gid) => {
          const data = dataByGroup[gid]();
          if (!data) return;
          const subtypes = filterState[gid].subtypes;
          n += data.features.filter(
            (f) => subtypes.has(f.properties.subtype) && matchesStatus(f.properties)
          ).length;
        });
        return n;
      }

      function syncGroupAllLabels() {
        document.querySelectorAll('.filter-group-all').forEach((btn) => {
          const gid = btn.getAttribute('data-group-all');
          const showLabel = btn.getAttribute('data-label-show') || 'Mostra';
          const hideLabel = btn.getAttribute('data-label-hide') || 'Nascondi';
          let anyOn = false;
          if (gid === 'connections') {
            anyOn = filterState.connections.types.size > 0;
          } else if (gid === 'status') {
            anyOn = filterState.status.size > 0;
          } else if (FILTER_GROUPS[gid]) {
            anyOn = filterState[gid].subtypes.size > 0;
          }
          btn.textContent = anyOn ? hideLabel : showLabel;
        });
      }

      function updateFilterCounts() {
        let total = 0;
        ['data_centers', 'energy_plants', 'raw_materials', 'connections'].forEach((id) => {
          const n = countVisible(id);
          total += n;
          const el = document.querySelector(`[data-count-for="${id}"]`);
          if (el) el.textContent = String(n);
        });
        const statusCountEl = document.querySelector('[data-count-for="status"]');
        if (statusCountEl) statusCountEl.textContent = String(countStatusVisible());
        const summary = document.getElementById('filters-count');
        if (summary) {
          const label = summary.getAttribute('data-label') || 'Visibili';
          summary.textContent = `${label} ${total}`;
        }
        syncGroupAllLabels();
      }

      function applyFilters() {
        const statusOn = filterState.status.size > 0;
        const badgeLayerByGroup = {
          data_centers: 'data-centers-status-badges',
          energy_plants: 'energy-plants-status-badges',
          raw_materials: 'raw-materials-status-badges'
        };
        Object.keys(FILTER_GROUPS).forEach((gid) => {
          const group = FILTER_GROUPS[gid];
          const state = filterState[gid];
          const visible = state.subtypes.size > 0 && statusOn;
          map.setLayoutProperty(group.layerId, 'visibility', visible ? 'visible' : 'none');
          if (visible) {
            map.setFilter(group.layerId, siteLayerFilter(gid));
          }
          const badgeId = badgeLayerByGroup[gid];
          if (badgeId && map.getLayer(badgeId)) {
            map.setLayoutProperty(badgeId, 'visibility', visible ? 'visible' : 'none');
            if (visible) {
              map.setFilter(badgeId, [
                'all',
                siteLayerFilter(gid),
                [
                  'in',
                  STATUS_GET_EXPR,
                  [
                    'literal',
                    ['operational', 'under_construction', 'planned', 'decommissioned'].filter((s) =>
                      filterState.status.has(s)
                    )
                  ]
                ]
              ]);
            }
          }
        });

        CONNECTION_TYPES.forEach((rel) => {
          const layerId = connLayerByRel[rel];
          const show = filterState.connections.types.has(rel);
          map.setLayoutProperty(layerId, 'visibility', show ? 'visible' : 'none');
        });

        updateFilterCounts();
      }

      function syncChipUI() {
        document.querySelectorAll('.filter-chip[data-subtype]').forEach((btn) => {
          const group = btn.getAttribute('data-group');
          const subtype = btn.getAttribute('data-subtype');
          const on = filterState[group].subtypes.has(subtype);
          btn.classList.toggle('is-on', on);
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        document.querySelectorAll('.filter-chip[data-rel]').forEach((btn) => {
          const rel = btn.getAttribute('data-rel');
          const on = filterState.connections.types.has(rel);
          btn.classList.toggle('is-on', on);
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        document.querySelectorAll('.filter-chip[data-status]').forEach((btn) => {
          const status = btn.getAttribute('data-status');
          const on = filterState.status.has(status);
          btn.classList.toggle('is-on', on);
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        syncGroupAllLabels();
      }

      function resetFilters() {
        Object.keys(FILTER_GROUPS).forEach((gid) => {
          filterState[gid].subtypes = new Set(FILTER_GROUPS[gid].subtypes);
        });
        filterState.connections.types = new Set(CONNECTION_TYPES);
        filterState.status = new Set(SITE_STATUSES);
        syncChipUI();
        applyFilters();
      }

      function toggleGroupAll(gid) {
        if (gid === 'connections') {
          if (filterState.connections.types.size > 0) {
            filterState.connections.types.clear();
          } else {
            filterState.connections.types = new Set(CONNECTION_TYPES);
          }
        } else if (gid === 'status') {
          if (filterState.status.size > 0) {
            filterState.status.clear();
          } else {
            filterState.status = new Set(SITE_STATUSES);
          }
        } else if (FILTER_GROUPS[gid]) {
          if (filterState[gid].subtypes.size > 0) {
            filterState[gid].subtypes.clear();
          } else {
            filterState[gid].subtypes = new Set(FILTER_GROUPS[gid].subtypes);
          }
        } else {
          return;
        }
        syncChipUI();
        applyFilters();
      }

      document.querySelectorAll('.filter-chip[data-subtype]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const group = btn.getAttribute('data-group');
          const subtype = btn.getAttribute('data-subtype');
          const set = filterState[group].subtypes;
          if (set.has(subtype)) set.delete(subtype);
          else set.add(subtype);
          syncChipUI();
          applyFilters();
        });
      });

      document.querySelectorAll('.filter-chip[data-rel]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const rel = btn.getAttribute('data-rel');
          const set = filterState.connections.types;
          if (set.has(rel)) set.delete(rel);
          else set.add(rel);
          syncChipUI();
          applyFilters();
        });
      });

      document.querySelectorAll('.filter-chip[data-status]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const status = btn.getAttribute('data-status');
          if (filterState.status.has(status)) filterState.status.delete(status);
          else filterState.status.add(status);
          syncChipUI();
          applyFilters();
        });
      });

      document.querySelectorAll('.filter-group-all').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggleGroupAll(btn.getAttribute('data-group-all'));
        });
      });

      const resetBtn = document.getElementById('filters-reset');
      if (resetBtn) resetBtn.addEventListener('click', resetFilters);

      function setOverlayVisibility(overlayId, on) {
        const def = CONTEXT_OVERLAYS.find((o) => o.id === overlayId);
        if (!def) return;
        def.layerIds.forEach((layerId) => {
          if (map.getLayer(layerId)) {
            map.setLayoutProperty(layerId, 'visibility', on ? 'visible' : 'none');
          }
        });
      }

      document.querySelectorAll('.filter-chip[data-overlay]').forEach((btn) => {
        const overlayId = btn.getAttribute('data-overlay');
        setOverlayVisibility(overlayId, btn.classList.contains('is-on'));
        btn.addEventListener('click', () => {
          const on = !btn.classList.contains('is-on');
          btn.classList.toggle('is-on', on);
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          setOverlayVisibility(overlayId, on);
        });
      });

      // Tooltip on overlay features
      ['overlay-cables-line', 'overlay-cable-landings', 'overlay-water-fill'].forEach((layerId) => {
        map.on('mouseenter', layerId, () => { map.getCanvas().style.cursor = 'pointer'; });
        map.on('mouseleave', layerId, () => { map.getCanvas().style.cursor = ''; hideTooltip(); });
        map.on('mousemove', layerId, (e) => {
          const f = e.features && e.features[0];
          if (!f) return;
          const p = f.properties || {};
            const text = p.name
            ? (p.bws_label
              ? `${p.region || p.name} — ${p.bws_label}`
              : p.name)
            : '';
          if (text) showTooltip(e, text);
        });
      });

      applyFilters();
    });
  </script>
</Layout>
