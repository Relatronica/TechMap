---
import ContentPage from '../components/ContentPage.astro';
import { getMessages, resolveLocale, localePath } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const i18n = getMessages(locale);
const p = i18n.legal.terms;
---

<ContentPage
  title={p.title}
  description={p.lead}
  kicker={p.kicker}
  heading={p.heading}
  lead={p.lead}
>
  <article class="content-prose">
    <p class="content-meta">
      {i18n.legal.updated_label}: <time datetime={p.updated}>{p.updated}</time>
    </p>
    {p.sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <p>{section.body}</p>
      </section>
    ))}
    <div class="content-actions">
      <a class="btn btn-accent" href={localePath('/mappa', locale)}>{i18n.home.cta_map}</a>
      <a class="btn btn-ghost-light" href={localePath('/privacy', locale)}>
        {i18n.legal.nav_privacy}
      </a>
    </div>
  </article>
</ContentPage>
