---
interface Props {
  title: string;
  description?: string;
  withMap?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = "L'infrastruttura fisica dietro cloud e intelligenza artificiale: data center, energia, materie prime.",
  withMap = false,
  bodyClass = ''
} = Astro.props;
---
<!DOCTYPE html>
<html lang="it" class={bodyClass}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
  {withMap && (
    <>
      <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
      <script is:inline src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    </>
  )}
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
