---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/site-header.css';
import '../styles/fonts.css';
import {
  getMessages,
  resolveLocale,
  localePath,
  switchLocalePath,
  ogLocale,
  defaultLocale,
  type Locale
} from '../i18n';

interface Props {
  title: string;
  description?: string;
  withMap?: boolean;
  bodyClass?: string;
  ogType?: 'website' | 'article';
}

const locale = resolveLocale(Astro.currentLocale);
const i18n = getMessages(locale);

const {
  title,
  description = locale === 'en'
    ? 'The physical infrastructure behind cloud and artificial intelligence: data centers, energy, raw materials.'
    : "L'infrastruttura fisica dietro cloud e intelligenza artificiale: data center, energia, materie prime.",
  withMap = false,
  bodyClass = '',
  ogType = 'website'
} = Astro.props;

const headerVariant = bodyClass.includes('is-map') ? 'map' : 'home';
const showHeader =
  bodyClass.includes('is-home') ||
  bodyClass.includes('is-map') ||
  bodyClass.includes('is-content');

const site = Astro.site ?? new URL('https://substrato.eu');
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL('/og-image.jpg', site);
const siteName = i18n.app.title;
const orgName = i18n.app.relatronica_name;
const orgURL = i18n.app.relatronica_url;

const altLocales = (['it', 'en'] as Locale[]).filter((l) => l !== locale);
const hreflangs = (['it', 'en'] as Locale[]).map((l) => ({
  lang: l,
  href: new URL(switchLocalePath(Astro.url.pathname, l), site).href
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.origin}/#organization`,
      name: orgName,
      url: orgURL,
      email: i18n.app.press_email
    },
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      name: siteName,
      alternateName: i18n.app.subtitle,
      url: site.origin,
      description,
      inLanguage: locale,
      publisher: { '@id': `${site.origin}/#organization` }
    },
    {
      '@type': 'Dataset',
      '@id': `${site.origin}${localePath('/mappa', defaultLocale)}/#dataset`,
      name: `${siteName} — dataset`,
      description:
        locale === 'en'
          ? 'Curated dataset of data centers, power plants, extraction/production sites and supply-chain links, focused on Italy and Europe. Certainty criteria and source limits: /metodologia.'
          : 'Dataset curato di data center, impianti energetici, siti di estrazione/produzione e connessioni di filiera, con focus su Italia ed Europa. Criteri di certainty e limiti delle fonti: /metodologia.',
      url: new URL(localePath('/mappa', locale), site).href,
      license: 'https://www.gnu.org/licenses/agpl-3.0.html',
      creator: { '@id': `${site.origin}/#organization` },
      isAccessibleForFree: true,
      inLanguage: locale,
      spatialCoverage: {
        '@type': 'Place',
        name: locale === 'en' ? 'Italy and Europe' : 'Italia ed Europa'
      },
      documentation: new URL(localePath('/metodologia', locale), site).href,
      distribution: [
        {
          '@type': 'DataDownload',
          encodingFormat: 'application/geo+json',
          contentUrl: new URL('/data/data_centers.geojson', site).href
        },
        {
          '@type': 'DataDownload',
          encodingFormat: 'application/geo+json',
          contentUrl: new URL('/data/energy_plants.geojson', site).href
        },
        {
          '@type': 'DataDownload',
          encodingFormat: 'application/geo+json',
          contentUrl: new URL('/data/raw_materials.geojson', site).href
        }
      ]
    }
  ]
};
---
<!DOCTYPE html>
<html lang={locale} class={bodyClass} data-locale={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f1216" />
  <meta name="geo.region" content="EU" />
  <meta name="geo.placename" content={locale === 'en' ? 'Italy, Europe' : 'Italia, Europa'} />
  <title>{title}</title>

  <link rel="canonical" href={canonicalURL} />
  {hreflangs.map((h) => (
    <link rel="alternate" hreflang={h.lang} href={h.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(Astro.url.pathname, 'it'), site).href} />
  <link rel="icon" href="/favicon.svg?v=pyramid-4" type="image/svg+xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={ogLocale(locale)} />
  {altLocales.map((l) => (
    <meta property="og:locale:alternate" content={ogLocale(l)} />
  ))}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1280" />
  <meta property="og:image:height" content="720" />
  <meta property="og:image:alt" content={`${siteName} — ${i18n.app.subtitle}`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={`${siteName} — ${i18n.app.subtitle}`} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class={bodyClass}>
  {showHeader && <SiteHeader variant={headerVariant} />}
  <slot />
</body>
</html>
