---
/**
 * MapView.astro — chrome UI sulla mappa (filtri + dettaglio)
 */
import i18n from '../i18n/it.json';
import {
  FILTER_GROUPS,
  CONNECTION_TYPES,
  ICON_PATHS,
  colorForSubtype,
  CONTEXT_OVERLAYS
} from '../lib/mapIcons';

type DatasetMeta = {
  updated_at?: string;
  methodology_it?: string;
  layers?: Record<string, { total?: number; curated?: number; imported?: number }>;
  sources?: Array<{
    id: string;
    title: string;
    url: string;
    license: string;
    license_url?: string;
    used_for?: string[];
    note_it?: string;
  }>;
};

let datasetMeta: DatasetMeta = {};
try {
  datasetMeta = (await import('../../public/data/dataset_meta.json')).default as DatasetMeta;
} catch {
  /* merge script not run yet */
}

const activeSources = (datasetMeta.sources || []).filter(
  (s) => Array.isArray(s.used_for) && s.used_for.some((u) => u !== 'basemap')
);
const basemapSource = (datasetMeta.sources || []).find((s) => s.used_for?.includes('basemap'));

type SubtypeKey = keyof typeof ICON_PATHS;

const short = (key: string) =>
  (i18n as { subtypes_short?: Record<string, string> }).subtypes_short?.[key] ||
  (i18n.subtypes as Record<string, string>)[key] ||
  key;

const pathFor = (subtype: string) => ICON_PATHS[subtype as SubtypeKey];

const overlayLabels = i18n.overlays as Record<string, string>;
const overlayText = (key: string) => overlayLabels[key] || key;
---

<div id="map"></div>
<div id="map-tooltip" class="map-tooltip"></div>

<div class="map-chrome">
  <div class="panel filters-panel" id="filters-panel">
    <div class="filters-header">
      <h3>{i18n.controls.filters}</h3>
      <button type="button" id="filters-reset" class="filters-reset">{i18n.controls.reset_filters}</button>
    </div>
    <p class="filters-count" id="filters-count"></p>

    {Object.values(FILTER_GROUPS).map((group) => (
      <details class="filter-group" open data-group={group.id}>
        <summary class="filter-group-summary">
          <span class="filter-group-left">
            <span class={`filter-group-swatch swatch-${group.colorVar}`} aria-hidden="true"></span>
            <span class="filter-group-title">{i18n.layers[group.id as keyof typeof i18n.layers]}</span>
          </span>
          <span class="filter-group-count" data-count-for={group.id}>0</span>
        </summary>
        <div class="filter-chips" data-chips-for={group.id}>
          {group.subtypes.map((subtype) => (
            <button
              type="button"
              class={`filter-chip is-on chip-${group.colorVar}`}
              data-group={group.id}
              data-subtype={subtype}
              aria-pressed="true"
              title={(i18n.subtypes as Record<string, string>)[subtype]}
              style={`--chip-color: ${colorForSubtype(subtype, group.color)};`}
            >
              <svg class="filter-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d={pathFor(subtype)}></path>
              </svg>
              <span>{short(subtype)}</span>
            </button>
          ))}
        </div>
      </details>
    ))}

    <details class="filter-group" open data-group="connections">
      <summary class="filter-group-summary">
        <span class="filter-group-left">
          <span class="filter-group-swatch swatch-conn" aria-hidden="true"></span>
          <span class="filter-group-title">{i18n.layers.connections}</span>
        </span>
        <span class="filter-group-count" data-count-for="connections">0</span>
      </summary>
      <div class="filter-chips" data-chips-for="connections">
        {CONNECTION_TYPES.map((rel) => (
          <button
            type="button"
            class="filter-chip is-on chip-conn"
            data-group="connections"
            data-rel={rel}
            aria-pressed="true"
            title={(i18n.relationships as Record<string, string>)[rel]}
            style={`--chip-color: ${
              rel === 'powers' ? 'var(--ep)' : rel === 'supplies' ? 'var(--rm)' : 'var(--dc)'
            };`}
          >
            <span class={`conn-swatch conn-${rel}`} aria-hidden="true"></span>
            <span>
              {rel === 'powers'
                ? i18n.legend.line_powers
                : rel === 'supplies'
                  ? i18n.legend.line_supplies
                  : i18n.legend.line_manufactures}
            </span>
          </button>
        ))}
      </div>
    </details>

    <details class="filter-group" open data-group="overlays">
      <summary class="filter-group-summary">
        <span class="filter-group-left">
          <span class="filter-group-swatch swatch-overlay" aria-hidden="true"></span>
          <span class="filter-group-title">{i18n.overlays.title}</span>
        </span>
      </summary>
      <div class="filter-chips" data-chips-for="overlays">
        {CONTEXT_OVERLAYS.map((overlay) => (
          <button
            type="button"
            class={`filter-chip chip-overlay${overlay.defaultOn ? ' is-on' : ''}`}
            data-overlay={overlay.id}
            aria-pressed={overlay.defaultOn ? 'true' : 'false'}
            title={overlayText(overlay.hintKey)}
            style={`--chip-color: ${overlay.color};`}
          >
            <span class={`overlay-swatch overlay-swatch-${overlay.swatch}`} aria-hidden="true"></span>
            <span>{overlayText(overlay.labelKey)}</span>
          </button>
        ))}
      </div>
    </details>

    {datasetMeta.updated_at && (
      <div class="filters-footer">
        <button type="button" id="data-attribution-open" class="filters-attribution-btn">
          {i18n.data_attribution.open}
        </button>
        <time class="filters-attribution-date" datetime={datasetMeta.updated_at}>
          {i18n.data_attribution.updated}: {datasetMeta.updated_at}
        </time>
      </div>
    )}
  </div>

  <aside id="detail-sidebar" class="panel detail-sidebar" aria-live="polite">
    <div class="detail-sidebar-header">
      <div>
        <h2 id="detail-title"></h2>
        <div id="detail-type" class="detail-type-chip" hidden></div>
      </div>
      <button id="detail-close" class="panel-close-btn" type="button" aria-label={i18n.popup.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div id="detail-body" class="detail-sidebar-body"></div>
  </aside>
</div>

<dialog id="data-attribution-modal" class="data-attribution-modal" aria-labelledby="data-attribution-title">
    <div class="data-attribution-modal-inner">
      <header class="data-attribution-modal-header">
        <h2 id="data-attribution-title">{i18n.data_attribution.title}</h2>
        <button
          type="button"
          id="data-attribution-close"
          class="panel-close-btn"
          aria-label={i18n.popup.close}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </header>
      <div class="data-attribution-modal-body">
        {datasetMeta.updated_at && (
          <p class="attribution-updated">
            {i18n.data_attribution.updated}:{' '}
            <time datetime={datasetMeta.updated_at}>{datasetMeta.updated_at}</time>
          </p>
        )}
        {datasetMeta.layers && (
          <ul class="attribution-counts">
            {datasetMeta.layers.energy_plants && (
              <li>
                {i18n.layers.energy_plants}: {datasetMeta.layers.energy_plants.total}{' '}
                ({datasetMeta.layers.energy_plants.curated} {i18n.data_attribution.curated},{' '}
                {datasetMeta.layers.energy_plants.imported} {i18n.data_attribution.imported})
              </li>
            )}
            {datasetMeta.layers.data_centers && (
              <li>
                {i18n.layers.data_centers}: {datasetMeta.layers.data_centers.total}{' '}
                ({datasetMeta.layers.data_centers.curated} {i18n.data_attribution.curated},{' '}
                {datasetMeta.layers.data_centers.imported} {i18n.data_attribution.imported})
              </li>
            )}
          </ul>
        )}
        {datasetMeta.methodology_it && (
          <p class="attribution-note">{datasetMeta.methodology_it}</p>
        )}
        {activeSources.length > 0 && (
          <ul class="attribution-sources">
            {activeSources.map((src) => (
              <li>
                <a href={src.url} target="_blank" rel="noopener noreferrer">{src.title}</a>
                {' — '}
                {src.license_url ? (
                  <a href={src.license_url} target="_blank" rel="noopener noreferrer">{src.license}</a>
                ) : (
                  src.license
                )}
                {src.note_it && <span class="attribution-source-note">{src.note_it}</span>}
              </li>
            ))}
          </ul>
        )}
        {basemapSource && (
          <p class="attribution-basemap">
            {i18n.data_attribution.basemap}:{' '}
            <a href={basemapSource.url} target="_blank" rel="noopener noreferrer">{basemapSource.title}</a>
            {' — '}{basemapSource.note_it}
          </p>
        )}
      </div>
    </div>
  </dialog>

<script>
  const openBtn = document.getElementById('data-attribution-open');
  const closeBtn = document.getElementById('data-attribution-close');
  const modal = document.getElementById('data-attribution-modal') as HTMLDialogElement | null;

  if (openBtn && closeBtn && modal) {
    openBtn.addEventListener('click', () => modal.showModal());
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    modal.addEventListener('cancel', () => modal.close());
  }
</script>
