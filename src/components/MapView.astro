---
/**
 * MapView.astro — chrome UI sulla mappa (filtri + dettaglio)
 */
import i18n from '../i18n/it.json';
import { FILTER_GROUPS, CONNECTION_TYPES, ICON_PATHS } from '../lib/mapIcons';
import SiteHeader from './SiteHeader.astro';

type SubtypeKey = keyof typeof ICON_PATHS;

const short = (key: string) =>
  (i18n as { subtypes_short?: Record<string, string> }).subtypes_short?.[key] ||
  (i18n.subtypes as Record<string, string>)[key] ||
  key;

const pathFor = (subtype: string) => ICON_PATHS[subtype as SubtypeKey];
---

<div id="map"></div>
<div id="map-tooltip" class="map-tooltip"></div>

<div class="map-chrome">
  <SiteHeader variant="map" />

  <div class="panel filters-panel" id="filters-panel">
    <div class="filters-header">
      <h3>{i18n.controls.filters}</h3>
      <button type="button" id="filters-reset" class="filters-reset">{i18n.controls.reset_filters}</button>
    </div>
    <p class="filters-count" id="filters-count"></p>

    {Object.values(FILTER_GROUPS).map((group) => (
      <details class="filter-group" open data-group={group.id}>
        <summary class="filter-group-summary">
          <span class="filter-group-left">
            <span class={`filter-group-swatch swatch-${group.colorVar}`} aria-hidden="true"></span>
            <span class="filter-group-title">{i18n.layers[group.id as keyof typeof i18n.layers]}</span>
          </span>
          <span class="filter-group-right">
            <span class="filter-group-count" data-count-for={group.id}>0</span>
            <label class="toggle-switch filter-group-toggle" style={`--toggle-color: var(--${group.colorVar});`}>
              <input type="checkbox" class="group-enabled" data-group={group.id} checked />
              <span class="toggle-slider"></span>
            </label>
          </span>
        </summary>
        <div class="filter-chips" data-chips-for={group.id}>
          {group.subtypes.map((subtype) => (
            <button
              type="button"
              class={`filter-chip is-on chip-${group.colorVar}`}
              data-group={group.id}
              data-subtype={subtype}
              aria-pressed="true"
              title={(i18n.subtypes as Record<string, string>)[subtype]}
            >
              <svg class="filter-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d={pathFor(subtype)}></path>
              </svg>
              <span>{short(subtype)}</span>
            </button>
          ))}
        </div>
      </details>
    ))}

    <details class="filter-group" open data-group="connections">
      <summary class="filter-group-summary">
        <span class="filter-group-left">
          <span class="filter-group-swatch swatch-conn" aria-hidden="true"></span>
          <span class="filter-group-title">{i18n.layers.connections}</span>
        </span>
        <span class="filter-group-right">
          <span class="filter-group-count" data-count-for="connections">0</span>
          <label class="toggle-switch filter-group-toggle" style="--toggle-color: var(--conn);">
            <input type="checkbox" class="group-enabled" data-group="connections" checked />
            <span class="toggle-slider"></span>
          </label>
        </span>
      </summary>
      <div class="filter-chips" data-chips-for="connections">
        {CONNECTION_TYPES.map((rel) => (
          <button
            type="button"
            class="filter-chip is-on chip-conn"
            data-group="connections"
            data-rel={rel}
            aria-pressed="true"
            title={(i18n.relationships as Record<string, string>)[rel]}
          >
            <span class={`conn-swatch conn-${rel}`} aria-hidden="true"></span>
            <span>
              {rel === 'powers'
                ? i18n.legend.line_powers
                : rel === 'supplies'
                  ? i18n.legend.line_supplies
                  : i18n.legend.line_manufactures}
            </span>
          </button>
        ))}
      </div>
    </details>
  </div>

  <div id="legend-panel" class="panel legend-panel">
    <div id="legend-header" class="legend-header">
      <h3>{i18n.legend.title}</h3>
      <span class="legend-toggle-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"></path></svg>
      </span>
    </div>
    <div class="legend-content" id="legend-content">
      {Object.values(FILTER_GROUPS).map((group) => (
        <div class="legend-section">
          <div class="legend-section-title">{i18n.layers[group.id as keyof typeof i18n.layers]}</div>
          {group.subtypes.map((subtype) => (
            <div class="legend-item" data-legend-subtype={subtype}>
              <span class={`legend-icon-badge badge-${group.colorVar}`}>
                <svg class="legend-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={pathFor(subtype)}></path>
                </svg>
              </span>
              <span>{short(subtype)}</span>
            </div>
          ))}
        </div>
      ))}
      <div class="legend-section">
        <div class="legend-section-title">{i18n.legend.lines}</div>
        <div class="legend-item">
          <span class="legend-line" style="border-color: var(--ep);"></span>
          {i18n.legend.line_powers}
        </div>
        <div class="legend-item">
          <span class="legend-line" style="border-color: var(--rm);"></span>
          {i18n.legend.line_supplies}
        </div>
        <div class="legend-item">
          <span class="legend-line" style="border-color: var(--dc);"></span>
          {i18n.legend.line_manufactures}
        </div>
      </div>
    </div>
  </div>

  <aside id="detail-sidebar" class="panel detail-sidebar" aria-live="polite">
    <div class="detail-sidebar-header">
      <div>
        <h2 id="detail-title"></h2>
        <div id="detail-type" class="detail-type-chip" hidden></div>
      </div>
      <button id="detail-close" class="panel-close-btn" type="button" aria-label={i18n.popup.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div id="detail-body" class="detail-sidebar-body"></div>
  </aside>
</div>
