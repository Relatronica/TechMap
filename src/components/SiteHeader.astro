---
/**
 * Chrome di navigazione — sticky/fixed con vetro, scroll-state, CTA chiare.
 * Home: fixed trasparente sopra l'hero, si compatta allo scroll.
 * Content: sticky vetro.
 * Mappa: fixed sopra il tool.
 */
import i18n from '../i18n/it.json';

interface Props {
  variant?: 'home' | 'map';
}

const { variant = 'home' } = Astro.props;
const h = i18n.home;
const app = i18n.app;
const isMap = variant === 'map';

const anchors = isMap
  ? []
  : [
      { href: '/#problema', label: h.nav_problem },
      { href: '/#dati', label: h.nav_data },
      { href: '/#faq', label: h.nav_faq }
    ];
---

<header class="site-chrome" id="site-header" data-variant={variant}>
  <div class="site-chrome-bar">
    <a class="site-chrome-brand" href="/" aria-label={`${app.title} — ${app.subtitle}`}>
      <span class="atlas-mark site-chrome-mark" aria-hidden="true"></span>
      <span class="site-chrome-name">{app.title}</span>
    </a>

    {!isMap && (
      <nav class="site-chrome-nav" aria-label="Sezioni">
        {anchors.map((a) => (
          <a href={a.href}>{a.label}</a>
        ))}
      </nav>
    )}

    <div class="site-chrome-actions">
      {isMap ? (
        <a class="site-chrome-link" href="/">{h.nav_home}</a>
      ) : (
        <a
          class="site-chrome-support"
          href={app.support_url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={h.nav_support_aria}
        >
          <svg class="site-chrome-support-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="site-chrome-support-label">{h.nav_support}</span>
        </a>
      )}

      <a
        class:list={['site-chrome-cta', isMap && 'is-active']}
        href="/mappa"
        aria-current={isMap ? 'page' : undefined}
      >
        {isMap ? h.nav_map : h.cta_map}
      </a>

      {!isMap && (
        <button
          type="button"
          class="site-chrome-menu"
          id="site-header-menu"
          aria-expanded="false"
          aria-controls="site-header-drawer"
          aria-label="Menu"
        >
          <span class="site-chrome-menu-lines" aria-hidden="true"></span>
        </button>
      )}
    </div>
  </div>

  {!isMap && (
    <div class="site-chrome-drawer" id="site-header-drawer" hidden>
      <nav aria-label="Menu">
        <a href="/">{h.nav_home}</a>
        {anchors.map((a) => (
          <a href={a.href}>{a.label}</a>
        ))}
        <a href="/#azioni">{h.nav_actions}</a>
        <a href="/#roadmap">{h.nav_roadmap}</a>
        <a href="/#diffondi">{h.nav_share}</a>
        <a
          class="is-support"
          href={app.support_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="site-chrome-support-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {h.footer_support}
        </a>
        <a class="is-cta" href="/mappa">{h.cta_map}</a>
      </nav>
    </div>
  )}
</header>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('site-header-menu');
  const drawer = document.getElementById('site-header-drawer');
  const variant = header?.dataset.variant || 'home';

  function syncScrollState() {
    if (!header || variant === 'map') return;
    const scrolled = window.scrollY > 12;
    header.classList.toggle('is-scrolled', scrolled);
  }

  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!open));
    if (drawer) drawer.hidden = open;
    header?.classList.toggle('is-menu-open', !open);
  });

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuBtn?.setAttribute('aria-expanded', 'false');
      if (drawer) drawer.hidden = true;
      header?.classList.remove('is-menu-open');
    });
  });

  syncScrollState();
  window.addEventListener('scroll', syncScrollState, { passive: true });
</script>
