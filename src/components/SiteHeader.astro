---
/**
 * Header unico — stesso su home e mappa
 */
import i18n from '../i18n/it.json';

interface Props {
  variant?: 'home' | 'map';
}

const { variant = 'home' } = Astro.props;
const h = i18n.home;
const app = i18n.app;
const isMap = variant === 'map';

const anchors = [
  { href: '/#problema', label: h.nav_problem },
  { href: '/#dati', label: h.nav_data },
  { href: '/#azioni', label: h.nav_actions },
  { href: '/#roadmap', label: h.nav_roadmap },
  { href: '/#faq', label: h.nav_faq },
  { href: '/#diffondi', label: h.nav_share }
];
---

<header class="site-header" id="site-header" data-variant={variant}>
  <div class="site-header-inner">
    <a class="site-header-brand" href="/" aria-label={`${app.title} — ${app.subtitle}`}>
      <svg class="site-header-logo" viewBox="0 0 28 28" aria-hidden="true">
        <rect x="5" y="5.5" width="18" height="5" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5" />
        <rect x="5" y="11.5" width="18" height="5" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5" />
        <rect class="logo-mark" x="5" y="17.5" width="18" height="5" rx="1.25" />
      </svg>
      <span class="site-header-brand-text">
        <strong>{app.title}</strong>
        <span>{app.subtitle}</span>
      </span>
    </a>

    <div class="site-header-end">
      <nav class="site-header-nav" aria-label="Sezioni">
        {anchors.map((a) => (
          <a href={a.href}>{a.label}</a>
        ))}
      </nav>

      <div class="site-header-actions">
        <button
          type="button"
          class="site-header-menu"
          id="site-header-menu"
          aria-expanded="false"
          aria-controls="site-header-drawer"
        >
          Menu
        </button>
        <a
          class="site-header-support"
          href={app.support_url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={h.nav_support_aria}
        >
          <svg class="site-header-btn-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 20.2S4.5 15.4 4.5 10.2A3.9 3.9 0 0 1 12 7.6a3.9 3.9 0 0 1 7.5 2.6C19.5 15.4 12 20.2 12 20.2Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linejoin="round"
            />
          </svg>
          {h.nav_support}
        </a>
        <a
          class:list={['site-header-cta', isMap && 'is-active']}
          href="/mappa"
          aria-current={isMap ? 'page' : undefined}
        >
          <svg class="site-header-btn-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 21s-6.5-5.6-6.5-10.2a6.5 6.5 0 1 1 13 0C18.5 15.4 12 21 12 21Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linejoin="round"
            />
            <circle cx="12" cy="10.8" r="2.2" fill="none" stroke="currentColor" stroke-width="1.75" />
          </svg>
          {h.nav_map}
        </a>
      </div>
    </div>
  </div>

  <div class="site-header-drawer" id="site-header-drawer" hidden>
    <nav aria-label="Sezioni mobile">
      <a href="/" class="site-header-drawer-link">{h.nav_home}</a>
      {anchors.map((a) => (
        <a href={a.href} class="site-header-drawer-link">{a.label}</a>
      ))}
      <a
        href={app.support_url}
        class="site-header-drawer-link is-support"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="site-header-btn-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 20.2S4.5 15.4 4.5 10.2A3.9 3.9 0 0 1 12 7.6a3.9 3.9 0 0 1 7.5 2.6C19.5 15.4 12 20.2 12 20.2Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"
          />
        </svg>
        {h.footer_support}
      </a>
      <a
        href="/mappa"
        class:list={['site-header-drawer-link', 'is-cta', isMap && 'is-active']}
        aria-current={isMap ? 'page' : undefined}
      >
        <svg class="site-header-btn-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 21s-6.5-5.6-6.5-10.2a6.5 6.5 0 1 1 13 0C18.5 15.4 12 21 12 21Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"
          />
          <circle cx="12" cy="10.8" r="2.2" fill="none" stroke="currentColor" stroke-width="1.75" />
        </svg>
        {h.cta_map}
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('site-header-menu');
  const drawer = document.getElementById('site-header-drawer');
  const isHome = document.body.classList.contains('is-home');

  function onScroll() {
    if (!header || !isHome) return;
    header.classList.toggle('is-scrolled', window.scrollY > 24);
  }

  onScroll();
  if (isHome) {
    window.addEventListener('scroll', onScroll, { passive: true });
  } else {
    header?.classList.add('is-scrolled');
  }

  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!open));
    if (drawer) drawer.hidden = open;
    header?.classList.toggle('is-menu-open', !open);
  });

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuBtn?.setAttribute('aria-expanded', 'false');
      if (drawer) drawer.hidden = true;
      header?.classList.remove('is-menu-open');
    });
  });
</script>
